+//! E2a probe witness: the vendored **accumulator-reader variant** decode
+//! path (`e2::decode_one_accumulator`) decodes the exact embedded clips
+//! **bit-exactly** against the `flac -d` reference PCM — the same
+//! layer-2 witness `spike_witness.rs` runs for the production
+//! position-reader path.
+//!
+//! This is the host half of the E2a equality story; the ROM adds the
+//! per-frame variant-vs-control witness on the measured image itself. The
+//! equivalence claim (module docs of `e2.rs`): the accumulator reader is a
+//! pure re-implementation of the same cursor — same values, same widths,
+//! same EOF/atomicity rules, `byte_align` landing on the same boundary —
+//! so a bit-exact decode against the encoder's ground truth is the machine
+//! check that the reader swap changed *how* bits are fetched, never
+//! *which* bits.
+//!
+//! Sample code, never lands on `main`'s spike sources (see
+//! `experiments/e2a-bit-reader-accumulator/`).
+
+use flac_spike::assets::{CLIPS, L0_FIXED, L4_LPC};
+use flac_spike::e2;
+
+/// The reference PCM blobs (host ground truth only — same blobs
+/// `spike_witness.rs` includes; re-included here so this file is a
+/// self-contained witness).
+const L0_PCM: &[u8] = include_bytes!("../assets/spike_l0_pcm.bin");
+const L4_PCM: &[u8] = include_bytes!("../assets/spike_l4_pcm.bin");
+
+fn pcm_for(name: &str) -> &'static [u8] {
+    if name == L0_FIXED.name {
+        L0_PCM
+    } else if name == L4_LPC.name {
+        L4_PCM
+    } else {
+        panic!("e2 witness does not know a blob for arm {name:?}");
+    }
+}
+
+#[test]
+fn accumulator_variant_decodes_bit_exact_against_the_reference_pcm() {
+    for clip in CLIPS {
+        let max = usize::from(clip.max_blocksize);
+        let mut left = vec![0i32; max];
+        let mut right = vec![0i32; max];
+        let mut state = Default::default();
+        let expected_len =
+            usize::try_from(clip.total_samples).unwrap() * usize::from(clip.channels) * 2;
+        let mut got: Vec<u8> = Vec::with_capacity(expected_len);
+
+        for frame_index in 0..clip.frames.len() {
+            let written =
+                e2::decode_one_accumulator(clip, frame_index, &mut left, &mut right, &mut state)
+                    .unwrap_or_else(|e| panic!("{}: frame {frame_index} failed: {e:?}", clip.name));
+            for k in 0..written {
+                let (a, b) = (
+                    i16::try_from(left[k]).expect("decoded left fits i16 (16-bit profile)"),
+                    i16::try_from(right[k]).expect("decoded right fits i16 (16-bit profile)"),
+                );
+                got.extend_from_slice(&a.to_le_bytes());
+                got.extend_from_slice(&b.to_le_bytes());
+            }
+        }
+
+        assert_eq!(
+            got,
+            pcm_for(clip.name),
+            "{}: the accumulator-reader variant is not bit-exact against `flac -d`",
+            clip.name
+        );
+    }
+}
