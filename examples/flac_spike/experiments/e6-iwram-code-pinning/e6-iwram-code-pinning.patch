+//! E6 probe witness: the vendored **IWRAM-pinned decode path**
+//! (`e6::decode_one_iwram`) decodes the exact embedded clips
+//! **bit-exactly** against the `flac -d` reference PCM — the same
+//! layer-2 witness `spike_witness.rs` runs for the production path — and
+//! **differentially frame-by-frame against the production
+//! `driver::decode_one`** on the same bytes.
+//!
+//! This is the host half of the E6 equality story; the ROM adds the
+//! per-frame variant-vs-control witness on the measured image itself. The
+//! equivalence claim (module docs of `e6.rs`): the vendored path is a
+//! verbatim copy of the `flac-lite` hot path — same reader semantics, same
+//! i64 arithmetic, same unary loop, same rejection/cursor rules — whose
+//! only difference is code placement (the `.text_iwram` attribute, ignored
+//! on the host build via `cfg_attr`). A transcription typo in any vendored
+//! body diverges against one of the two ground truths here; bit-exactness
+//! against `flac -d` proves the copy changed *how* the decode runs, never
+//! *what* it decodes.
+//!
+//! Sample code, never lands on `main`'s spike sources (see
+//! `experiments/e6-iwram-hot-code/`).
+
+use flac_lite::subframe::PredictorState;
+use flac_spike::assets::{CLIPS, L0_FIXED, L4_LPC};
+use flac_spike::driver;
+use flac_spike::e6;
+
+/// The reference PCM blobs (host ground truth only — same blobs
+/// `spike_witness.rs` includes; re-included here so this file is a
+/// self-contained witness).
+const L0_PCM: &[u8] = include_bytes!("../assets/spike_l0_pcm.bin");
+const L4_PCM: &[u8] = include_bytes!("../assets/spike_l4_pcm.bin");
+
+fn pcm_for(name: &str) -> &'static [u8] {
+    if name == L0_FIXED.name {
+        L0_PCM
+    } else if name == L4_LPC.name {
+        L4_PCM
+    } else {
+        panic!("e6 witness does not know a blob for arm {name:?}");
+    }
+}
+
+#[test]
+fn iwram_pinned_variant_decodes_bit_exact_against_the_reference_pcm() {
+    for clip in CLIPS {
+        let max = usize::from(clip.max_blocksize);
+        let mut left = vec![0i32; max];
+        let mut right = vec![0i32; max];
+        let mut state: [PredictorState; 2] = Default::default();
+        let expected_len =
+            usize::try_from(clip.total_samples).unwrap() * usize::from(clip.channels) * 2;
+        let mut got: Vec<u8> = Vec::with_capacity(expected_len);
+
+        for frame_index in 0..clip.frames.len() {
+            let written =
+                e6::decode_one_iwram(clip, frame_index, &mut left, &mut right, &mut state)
+                    .unwrap_or_else(|e| panic!("{}: frame {frame_index} failed: {e:?}", clip.name));
+            for k in 0..written {
+                let (a, b) = (
+                    i16::try_from(left[k]).expect("decoded left fits i16 (16-bit profile)"),
+                    i16::try_from(right[k]).expect("decoded right fits i16 (16-bit profile)"),
+                );
+                got.extend_from_slice(&a.to_le_bytes());
+                got.extend_from_slice(&b.to_le_bytes());
+            }
+        }
+
+        assert_eq!(
+            got,
+            pcm_for(clip.name),
+            "{}: the IWRAM-pinned variant is not bit-exact against `flac -d`",
+            clip.name
+        );
+    }
+}
+
+#[test]
+fn iwram_pinned_variant_matches_production_decode_frame_by_frame() {
+    // The differential half: every frame, the vendored path must produce
+    // exactly the samples the production driver produces — same buffers,
+    // fresh state per path, compared per frame so a divergence names its
+    // frame and slot (the ROM witness's host mirror; the PCM-pin test
+    // above rules out both paths drifting together against the encoder).
+    for clip in CLIPS {
+        let max = usize::from(clip.max_blocksize);
+        let mut prod_l = vec![0i32; max];
+        let mut prod_r = vec![0i32; max];
+        let mut var_l = vec![0i32; max];
+        let mut var_r = vec![0i32; max];
+        let mut state_p: [PredictorState; 2] = Default::default();
+        let mut state_v: [PredictorState; 2] = Default::default();
+
+        for frame_index in 0..clip.frames.len() {
+            let w_prod =
+                driver::decode_one(clip, frame_index, &mut prod_l, &mut prod_r, &mut state_p)
+                    .unwrap_or_else(|e| panic!("{}: prod frame {frame_index}: {e:?}", clip.name));
+            let w_var =
+                e6::decode_one_iwram(clip, frame_index, &mut var_l, &mut var_r, &mut state_v)
+                    .unwrap_or_else(|e| {
+                        panic!("{}: variant frame {frame_index}: {e:?}", clip.name)
+                    });
+            assert_eq!(
+                w_prod, w_var,
+                "{}: frame {frame_index} blocksize differs",
+                clip.name
+            );
+            for k in 0..w_prod {
+                assert_eq!(
+                    prod_l[k], var_l[k],
+                    "{}: frame {frame_index} left[{k}]",
+                    clip.name
+                );
+                if clip.channels == 2 {
+                    assert_eq!(
+                        prod_r[k], var_r[k],
+                        "{}: frame {frame_index} right[{k}]",
+                        clip.name
+                    );
+                }
+            }
+        }
+    }
+}
