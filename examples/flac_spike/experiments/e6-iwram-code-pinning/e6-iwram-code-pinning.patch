+// ---------------------------------------------------------------------------
+// Runtime placement witness (arm only).
+// ---------------------------------------------------------------------------
+
+/// Runtime placement witness (arm only): the address of the pinned
+/// `decode_rice_partition` copy the decode path calls into. Safe fn-pointer
+/// coercion to `usize`; a value in the `0x0300_0000..0x0300_8000` range
+/// proves the call-boundary copy the hot path enters executes from IWRAM.
+/// (The offline `nm`/`objdump` link witness is the primary check; this is
+/// the same-image runtime echo of it, logged next to the decode buffers'
+/// EWRAM addresses.)
+#[cfg(target_arch = "arm")]
+pub fn pinned_hot_loop_addr() -> usize {
+    let f: fn(&mut Reader<'_>, &PartitionHeader, &mut [i32]) -> Result<(), Error> =
+        decode_rice_partition;
+    f as usize
+}
+
+// ---------------------------------------------------------------------------
+// Seek-table entry point — mirrors driver::decode_one (unpinned, once/frame).
+// ---------------------------------------------------------------------------
+
+/// Decode exactly one frame — at its seek-table offset, with a fresh cursor
+/// — through the vendored IWRAM-pinned hot path. Mirrors `driver::decode_one`
+/// verbatim (same buffer contract, same table cross-check, same rejection
+/// variants); the body calls `e6::decode_frame` instead of the live one.
+/// Unpinned by design: the seek-table plumbing runs once per frame.
+pub fn decode_one_iwram(
+    clip: &SpikeClip,
+    frame_index: usize,
+    left: &mut [i32],
+    right: &mut [i32],
+    state: &mut [PredictorState; 2],
+) -> Result<usize, DriverError> {
+    let frame = &clip.frames[frame_index];
+    let max = usize::from(clip.max_blocksize);
+    if left.len() < max {
+        return Err(DriverError::BufferTooSmall {
+            need: max,
+            have: left.len(),
+        });
+    }
+    if clip.channels == 2 && right.len() < max {
+        return Err(DriverError::BufferTooSmall {
+            need: max,
+            have: right.len(),
+        });
+    }
+    let offset = match usize::try_from(frame.offset) {
+        Ok(offset) => offset,
+        Err(_) => {
+            return Err(DriverError::FrameOffsetOutOfRange {
+                frame: frame_index,
+                offset: usize::MAX,
+                len: clip.region.len(),
+            });
+        }
+    };
+    let region = clip
+        .region
+        .get(offset..)
+        .ok_or(DriverError::FrameOffsetOutOfRange {
+            frame: frame_index,
+            offset,
+            len: clip.region.len(),
+        })?;
+
+    let defaults = StreamDefaults {
+        sample_rate_hz: clip.sample_rate_hz,
+        bits_per_sample: clip.bits_per_sample,
+    };
+    let mut reader = Reader::new(region);
+    let header = parse_header(&mut reader, &defaults).map_err(DriverError::Decode)?;
+    if header.blocksize != usize::from(frame.blocksize) {
+        return Err(DriverError::MetadataMismatch {
+            frame: frame_index,
+            table: usize::from(frame.blocksize),
+            header: header.blocksize,
+        });
+    }
+    decode_frame(&mut reader, &header, left, right, state).map_err(DriverError::Decode)
+}
