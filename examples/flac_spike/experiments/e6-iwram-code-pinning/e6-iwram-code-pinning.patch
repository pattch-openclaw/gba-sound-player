+                        found = Some(("left", k, ctrl_l[k], var_l[k]));
+                        break;
+                    }
+                    if clip.channels == 2 && ctrl_r[k] != var_r[k] {
+                        found = Some(("right", k, ctrl_r[k], var_r[k]));
+                        break;
+                    }
+                }
+                found
+            };
+            if let Some((slot, k, cv, vv)) = bad {
+                agb::println!(
+                    "*** {} e6 FAIL frame {}: variant diverges from ctrl in {}[{}] ctrl={} variant={} — numbers void",
+                    name,
+                    frame_index,
+                    slot,
+                    k,
+                    cv,
+                    vv
+                );
+                return None;
+            }
+            let ctrl_net = ctrl_raw.saturating_sub(overhead);
+            let var_net = var_raw.saturating_sub(overhead);
+            ctrl_cost.observe(frame_index, ctrl_net);
+            var_cost.observe(frame_index, var_net);
+            agb::println!(
+                "*** {} e6 frame {:>3}/{} bs={} ctrl_raw={} ctrl_net={} var_raw={} var_net={} eq=1",
+                name,
+                frame_index,
+                clip.frames.len(),
+                written,
+                ctrl_raw,
+                ctrl_net,
+                var_raw,
+                var_net
+            );
+        }
+
+        let mut pass = ctrl_cost.count == clip.frames.len() && var_cost.count == clip.frames.len();
+        if !pass {
+            agb::println!(
+                "*** {} e6 FAIL timed frames ctrl={} variant={} expected={}",
+                name,
+                ctrl_cost.count,
+                var_cost.count,
+                clip.frames.len()
+            );
+        }
+        for (arm, cost) in [("ctrl", &ctrl_cost), ("variant", &var_cost)] {
+            if cost.wrapped {
+                pass = false;
+                agb::println!(
+                    "*** {} e6 FAIL {} arm: a window exceeded the 32-bit composite: frame {} at sentinel {}",
+                    name,
+                    arm,
+                    cost.max_frame,
+                    WORST_WRAPPED
+                );
+            }
+        }
+        for (arm, cost) in [("ctrl", &ctrl_cost), ("variant", &var_cost)] {
+            agb::println!(
+                "*** {} e6 {} stats: count={} min={}@{} max={}@{} sum={} wrapped={}",
+                name,
+                arm,
+                cost.count,
+                cost.min,
+                cost.min_frame,
+                cost.max,
+                cost.max_frame,
+                cost.sum,
+                cost.wrapped
+            );
+            agb::println!(
+                "*** {} e6 {} budget: worst_frame={} worst_net={} vs budget={} [{}]",
+                name,
+                arm,
+                cost.max_frame,
+                cost.max,
+                BUDGET_CYCLES_PER_FRAME,
+                if cost.max <= BUDGET_CYCLES_PER_FRAME {
+                    "FITS"
+                } else {
+                    "OVER BUDGET"
+                }
+            );
+        }
+        let ctrl_fits = ctrl_cost.max <= BUDGET_CYCLES_PER_FRAME;
+        let var_fits = var_cost.max <= BUDGET_CYCLES_PER_FRAME;
+        if pass {
+            Some((ctrl_cost, var_cost, overhead, ctrl_fits, var_fits))
+        } else {
+            None
+        }
+    }
