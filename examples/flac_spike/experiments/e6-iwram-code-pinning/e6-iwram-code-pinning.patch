+//! E6 sample — hot decode code pinned to IWRAM (`.iwram`) (**probe code;
+//! never lands on `main`'s spike sources**).
+//!
+//! FLAC.md "Perf follow-ups — experiment menu", E6: E1 staged decode *data*
+//! into RAM, but the decode *code* still executes from cartridge ROM. The
+//! ARM7TDMI has no instruction cache — just a small prefetch buffer — so a
+//! branch-dense loop like the Rice unary loop pays non-sequential gamepak
+//! instruction fetches on nearly every iteration. E1 moved data reads, E3
+//! would move data writes, E4 changed arithmetic — none moved code. This
+//! module is a vendored **verbatim copy** of the `flac-lite` hot path whose
+//! *only* difference is code placement: the hot functions carry
+//! `#[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]` —
+//! cfg-gated so host witness builds ignore it (host Mach-O rejects the
+//! custom section name; the `unsafe(...)` wrapper is mandatory under
+//! edition 2024, where `link_section` is an unsafe attribute).
+//!
+//! **Section name: `.iwram`, NOT the menu's `.text_iwram` (measured).**
+//! gba.ld's `.text` output section pattern `*(.text .text*)` matches
+//! `.text_iwram`, and GNU ld assigns an input section to the FIRST
+//! matching output section — so `.text_iwram` is swallowed into `> rom`
+//! before the `.iwram` output section's own `*(.text_iwram .text_iwram.*)`
+//! entry can claim it. Verified on the built ELF: with the attribute set to
+//! `.text_iwram` the symbols stayed at ROM addresses (`0800xxxx`) and the
+//! `.iwram` section stayed at its baseline 0x22c. The plain `.iwram`
+//! section is what agb's own IWRAM-resident code uses (the
+//! `__aeabi`/`__agbabi` mem* helpers live there at `0x0300_00xx`) and is
+//! the working pin target. `.iwram` is `> iwram AT>rom`, copied ROM→IWRAM
+//! at boot by `CommonInit` via BIOS `CPUSet`. `crates/flac-lite/` is
+//! untouched — the same sample-only discipline as
+//! `experiments/e1-rom-ram-staging/`, `experiments/e4-i32-intermediates/`,
+//! and `experiments/e2a-bit-reader-accumulator/`.
+//!
+//! ## The one variable: code placement
+//!
+//! Every function below is a line-for-line copy of its `flac-lite` twin —
+//! same reader semantics (a verbatim copy of `bits::BitReader`), same i64
+//! arithmetic, same unary loop shape, same rejection and cursor rules. No
+//! algorithmic, width, or reader change rides along (that would be E2b/E4
+//! territory). The only intentional differences are *codegen placement*
+//! attributes, chosen so the measured image provably executes the hot path
+//! from IWRAM:
+//!
+//! - **Pinned, call-boundary set** (`#[inline(never)]` + the placement
+//!   pair):
+//!   `decode_frame`, `decode_subframe`, `decode_residual`,
+//!   `decode_rice_partition`, `integrate_fixed`, `integrate_lpc` — the
+//!   per-subframe / per-partition hot spine.
+//! - **Pinned, inline-leaf set** (`#[inline(always)]` + the placement
+//!   pair):
+//!   the reader's `read_bits`/`peek_at`/`read_signed`/`read_u8`, `rice_unmap`,
+//!   `pad_block`, `parse_subframe_type`, `fill_state`. `inline(always)` keeps
+//!   the reader materialized *inside* the pinned callers — the per-bit hot
+//!   loop carries **no extra call** vs the LTO-inlined control, so the
+//!   measurement isolates fetch location, not call overhead.
+//! - **Unpinned per-frame plumbing**: `parse_header` and its pure helpers,
+//!   the coded-number / wasted-bits composite readers, `decode_one` (the
+//!   seek-table wrapper), and the shared `stereo::decorrelate` (a real
+//!   shared call, exactly as in E2a — it takes no vendored type). These
+//!   execute once per frame from ROM; the menu's scope guide ("pin the hot
+//!   loop only, not the crate") applies.
+//!
+//! A consequence worth stating for the reading rule: with the reader
+//! inlined, every per-bit access in the variant is an IWRAM fetch; the
+//! control's identical per-bit code is a ROM fetch. If the variant collapses,
+//! instruction fetch from the gamepak is the cost center; if it does not,
+//! code placement joins the ruled-out list — either way the *what* is fixed
+//! by witnesses before any number counts.
+//!
+//! ## Witness chain (before any number counts)
+//!
+//! 1. Host (`tests/e6_witness.rs`): this vendored path decodes the exact
+//!    embedded clips bit-exactly vs the `flac -d` reference PCM, and
+//!    differentially frame-by-frame against the production
+//!    `driver::decode_one` — a transcription typo in any vendored body
+//!    diverges against one of the two.
+//! 2. ROM: a per-frame variant-vs-control sample-equality pass (the E1/E2a/E4
+//!    pattern) proves both paths agree on the measured image itself; first
+//!    offender named; divergence voids the numbers.
+//! 3. Link witness (offline, pre-measurement): `nm`/`objdump` on the built
+//!    ELF prove the pinned symbols landed in the `.iwram` section
+//!    (addresses in the `0x0300xxxx` range) — the attribute surviving
+//!    attributes × LTO is the menu's required pre-check before trusting any
+//!    number from the image.
+
+// E6 placement allowances (probe branch only; see module docs).
+// Edition-2024 + this nightly treat `link_section` as an unsafe attribute:
+// any use fires `unsafe_code` (deny after the probe's lib.rs change) and
+// bare use also fires `unsafe_attr_outside_unsafe`. The attribute is the
+// probe's one variable, gated to the bare-metal target; the host witness
+// build never sees it. No actual unsafe CODE exists in this module.
+#![allow(unsafe_code, unsafe_attr_outside_unsafe)]
+
+use crate::assets::SpikeClip;
+use crate::driver::DriverError;
+use flac_lite::format::{ChannelConfig, SampleRate};
+use flac_lite::frame::{FrameHeader, StreamDefaults};
+use flac_lite::residual::PartitionHeader;
+use flac_lite::stereo::decorrelate;
+use flac_lite::subframe::{PredictorState, SubframeType};
+use flac_lite::{Error, MAX_FIXED_ORDER, MAX_LPC_ORDER};
+
+/// The 14-bit frame sync (shared constant value from `frame.rs`).
+const SYNC_14: u32 = 0x3FFE;
+
+// ---------------------------------------------------------------------------
+// Vendored BitReader — verbatim copy of `flac_lite::bits::BitReader`.
+// ---------------------------------------------------------------------------
+
+/// Verbatim copy of the live position-only `BitReader` (same fields, same
+/// read path, same rules) — vendored only so the hot read primitives can
+/// carry the `.iwram` placement attribute. Semantics are identical by
+/// copy; the host witness pins that the copy never drifted.
+#[derive(Clone, Copy, Debug)]
+pub struct Reader<'a> {
+    /// Backing bytes (normally a subslice of a `&'static` ROM blob).
+    data: &'a [u8],
+    /// Read cursor, in bits from the start of `data`.
+    bit_pos: usize,
+}
+
+impl<'a> Reader<'a> {
+    /// Wrap a byte slice for bit-level reading.
+    #[inline(always)]
+    pub fn new(data: &'a [u8]) -> Self {
+        Self { data, bit_pos: 0 }
+    }
+
+    /// Read `n` bits (1..=32) as an unsigned value, MSB-first.
+    /// Verbatim live body; pinned inline leaf (E6 placement only).
+    #[inline(always)]
+    #[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]
+    pub fn read_bits(&mut self, n: u32) -> Result<u32, Error> {
+        let val = self.peek_at(self.bit_pos, n)?;
+        self.bit_pos += n as usize;
+        Ok(val)
+    }
+
+    /// Verbatim live `peek_bits`. Unpinned (no decode-path caller).
+    pub fn peek_bits(&self, n: u32) -> Result<u32, Error> {
+        self.peek_at(self.bit_pos, n)
+    }
+
+    /// Read `n` bits (1..=32) as a two's-complement signed value.
+    /// Verbatim live body; pinned inline leaf (warm-up / coefficient /
+    /// escaped-partition reads ride the hot path).
+    #[inline(always)]
+    #[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]
+    pub fn read_signed(&mut self, n: u32) -> Result<i32, Error> {
+        let raw = self.read_bits(n)?;
+        let shift = 32 - n;
+        Ok(((raw << shift) as i32) >> shift)
+    }
+
+    /// Consume bits up to the next byte boundary (frame footer). Verbatim
+    /// live body; unpinned (once per frame).
+    pub fn byte_align(&mut self) -> u32 {
+        let drop = (8 - (self.bit_pos & 7)) & 7;
+        self.bit_pos += drop;
+        drop as u32
+    }
+
+    /// Read a `u8` (8 bits). Verbatim live delegation; pinned inline leaf
+    /// (the footer reads land inside the pinned `decode_frame`).
+    #[inline(always)]
+    #[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]
+    pub fn read_u8(&mut self) -> Result<u8, Error> {
+        self.read_bits(8).map(|v| v as u8)
+    }
+
+    /// Read FLAC's UTF-8-style coded number (§9.1.5). Verbatim live
+    /// composite; unpinned (once per frame header).
+    pub fn read_utf8_coded(&mut self) -> Result<u64, Error> {
+        let start = self.bit_pos;
+        match self.coded_number_inner() {
+            Ok(v) => Ok(v),
+            Err(e) => {
+                self.bit_pos = start;
+                Err(e)
+            }
+        }
+    }
+
+    /// Read FLAC's wasted-bits-per-sample field (§9.2.2). Verbatim live
+    /// composite; unpinned (once per subframe).
+    pub fn read_wasted_bits(&mut self) -> Result<u32, Error> {
+        let start = self.bit_pos;
+        match self.wasted_inner() {
+            Ok(k) => Ok(k),
+            Err(e) => {
+                self.bit_pos = start;
+                Err(e)
+            }
+        }
+    }
+
+    /// Bits remaining in the backing slice from the current cursor.
+    #[inline(always)]
+    pub fn bits_remaining(&self) -> usize {
+        (self.data.len() << 3) - self.bit_pos
+    }
+
+    /// Current cursor position in bits.
+    #[inline(always)]
+    pub fn bit_position(&self) -> usize {
+        self.bit_pos
+    }
+
+    /// Verbatim live `peek_at` — the single place that touches the bytes.
+    /// Pinned inline leaf: materializes inside `read_bits`, so the per-bit
+    /// gather executes from wherever `read_bits`'s copy lives (IWRAM for
+    /// the pinned callers).
+    #[inline(always)]
+    #[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]
+    fn peek_at(&self, pos: usize, n: u32) -> Result<u32, Error> {
+        if n == 0 || n > 32 {
+            return Err(Error::InvalidField);
+        }
+        let total_bits = self.data.len() << 3;
+        // EOF rule verbatim (cursor + n must fit); the live crate binds the
+        // checked value — the `?` is the whole check, the binding is inert.
+        pos.checked_add(n as usize)
+            .filter(|&e| e <= total_bits)
+            .ok_or(Error::EndOfStream)?;
+
+        let byte_idx = pos >> 3;
+        let off = (pos & 7) as u32; // bit offset within the first byte, 0..=7
+        // Bytes spanned by bits [pos, end): division-free ceil((off + n) / 8).
+        let bytes_needed = (((off + n + 7) >> 3) as usize).min(self.data.len()); // <= 5
+
+        // Gather the spanned bytes, big-endian, into a bottom-aligned u64
+        // accumulator (width = bytes_needed * 8 <= 40 bits).
+        let mut acc: u64 = 0;
+        for &b in &self.data[byte_idx..byte_idx + bytes_needed] {
+            acc = (acc << 8) | u64::from(b);
+        }
+        let shift = bytes_needed as u32 * 8 - off - n;
+        let mask = (1u64 << n) - 1; // n in 1..=32, so this cannot overflow u64
+        Ok(((acc >> shift) & mask) as u32)
+    }
+
+    /// Verbatim live `wasted_inner` (unpinned; composite, once per subframe).
+    fn wasted_inner(&mut self) -> Result<u32, Error> {
+        if self.read_bits(1)? == 0 {
+            return Ok(0);
+        }
+        let mut zeros: u32 = 0;
+        loop {
+            if self.read_bits(1)? == 1 {
+                return Ok(zeros + 1);
+            }
+            zeros += 1;
+        }
+    }
+
+    /// Verbatim live `coded_number_inner` (unpinned; once per header).
+    fn coded_number_inner(&mut self) -> Result<u64, Error> {
+        let lead = self.read_bits(8)? as u8;
+        let mut prefix: u32 = 0;
+        let mut mask = 0x80u8;
+        while lead & mask != 0 {
+            prefix += 1;
+            mask >>= 1;
+        }
+        if prefix == 1 || prefix == 8 {
+            return Err(Error::InvalidField);
+        }
+        let total = if prefix == 0 { 1 } else { prefix };
+        let mut value = u64::from(u32::from(lead) & (0xFFu32 >> (prefix + 1)));
+        for _ in 1..total {
+            let cont = self.read_bits(8)? as u8;
+            if cont & 0xC0 != 0x80 {
+                return Err(Error::InvalidField);
+            }
+            value = (value << 6) | u64::from(cont & 0x3F);
+        }
+        Ok(value)
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Vendored frame-header layer — verbatim copies (unpinned: once per frame).
+// ---------------------------------------------------------------------------
+
+/// Vendored twin of `frame.rs`'s private `BlocksizeCode` (pure; no reader).
+enum BlocksizeCode {
+    Table(u16),
+    Uncommon8,
+    Uncommon16,
+}
+
+/// Vendored `frame::blocksize_code` (pure; verbatim).
+fn blocksize_code(code: u8) -> Result<BlocksizeCode, Error> {
+    match code {
+        0b0000 => Err(Error::InvalidField),
+        0b0001 => Ok(BlocksizeCode::Table(192)),
+        0b0010..=0b0101 => Ok(BlocksizeCode::Table((144u32 << code) as u16)),
+        0b0110 => Ok(BlocksizeCode::Uncommon8),
+        0b0111 => Ok(BlocksizeCode::Uncommon16),
+        0b1000..=0b1111 => Ok(BlocksizeCode::Table((1u32 << code as u32) as u16)),
+        _ => Err(Error::InvalidField),
+    }
+}
+
+/// Vendored `frame::channel_config` (pure; verbatim).
+fn channel_config(code: u8) -> Result<ChannelConfig, Error> {
+    match code {
+        0b0000 => Ok(ChannelConfig::Independent { channels: 1 }),
+        0b0001 => Ok(ChannelConfig::Independent { channels: 2 }),
+        0b0010..=0b0111 => Err(Error::ProfileViolation),
+        0b1000 => Ok(ChannelConfig::LeftSide),
+        0b1001 => Ok(ChannelConfig::RightSide),
+        0b1010 => Ok(ChannelConfig::MidSide),
+        _ => Err(Error::InvalidField),
+    }
+}
+
+/// Vendored `frame::bits_per_sample` (pure; verbatim).
+fn bits_per_sample(code: u8, defaults: &StreamDefaults) -> Result<u8, Error> {
+    match code {
+        0b000 => match defaults.bits_per_sample {
+            8 | 16 => Ok(defaults.bits_per_sample),
+            _ => Err(Error::UnsupportedSampleSize),
+        },
+        0b001 => Ok(8),
+        0b100 => Ok(16),
+        0b011 => Err(Error::InvalidField),
+        _ => Err(Error::UnsupportedSampleSize),
+    }
+}
+
+/// Vendored `frame::sample_rate` (reader type swapped to the verbatim copy).
+fn sample_rate(code: u8, reader: &mut Reader<'_>) -> Result<SampleRate, Error> {
+    let hz = match code {
+        0b1100 => {
+            let khz = reader.read_u8()? as u32;
+            if khz == 0 {
+                return Err(Error::InvalidField);
+            }
+            khz * 1000
+        }
+        0b1101 => {
+            let hz = reader.read_bits(16)?;
+            if hz == 0 {
+                return Err(Error::InvalidField);
+            }
+            return Ok(SampleRate::Explicit(hz));
+        }
+        0b1110 => {
+            let hz10 = reader.read_bits(16)?;
+            if hz10 == 0 {
+                return Err(Error::InvalidField);
+            }
+            hz10 * 10
+        }
+        _ => return SampleRate::from_flac_code(code),
+    };
+    Ok(SampleRate::Explicit(hz))
+}
+
+/// Vendored `frame::FrameHeader::parse` (reader type swapped; field order,
+/// validation, and cursor rules line-for-line identical). Unpinned.
+fn parse_header(reader: &mut Reader<'_>, defaults: &StreamDefaults) -> Result<FrameHeader, Error> {
+    if reader.bit_position() % 8 != 0 {
+        return Err(Error::FrameSync);
+    }
+
+    let sync = reader.read_bits(14)?;
+    if sync != SYNC_14 {
+        return Err(Error::FrameSync);
+    }
+    if reader.read_bits(1)? != 0 {
+        return Err(Error::InvalidField); // reserved bit must be zero
+    }
+    if reader.read_bits(1)? != 0 {
+        return Err(Error::ProfileViolation); // variable blocksize: off-profile
+    }
+    let bs_bits = reader.read_bits(4)? as u8;
+    let rate_code = reader.read_bits(4)? as u8;
+    let channels_code = reader.read_bits(4)? as u8;
+    let size_code = reader.read_bits(3)? as u8;
+    if reader.read_bits(1)? != 0 {
+        return Err(Error::InvalidField); // reserved bit must be zero
+    }
+    debug_assert_eq!(reader.bit_position() % 8, 0, "fixed fields are 32 bits");
+
+    let channels = channel_config(channels_code)?;
+    let bits_per_sample = bits_per_sample(size_code, defaults)?;
+    let bs_code = blocksize_code(bs_bits)?;
+
+    let number = reader.read_utf8_coded()?;
+    if number > 0x7FFF_FFFF {
+        return Err(Error::InvalidField);
+    }
+
+    let blocksize = match bs_code {
+        BlocksizeCode::Table(n) => n as usize,
+        BlocksizeCode::Uncommon8 => reader.read_u8()? as usize + 1,
+        BlocksizeCode::Uncommon16 => {
+            let stored = reader.read_bits(16)?;
+            if stored == 0xFFFF {
+                return Err(Error::InvalidField);
+            }
+            stored as usize + 1
+        }
+    };
+
+    let sample_rate = sample_rate(rate_code, reader)?;
+
+    let _crc8 = reader.read_u8()?;
+
+    Ok(FrameHeader {
+        blocksize,
+        sample_rate,
+        channels,
+        bits_per_sample,
+        number,
+    })
+}
+
+// ---------------------------------------------------------------------------
+// Vendored subframe layer — verbatim copies; pinned set.
+// ---------------------------------------------------------------------------
+
+/// Vendored `subframe::SubframeType::parse` (reader type swapped; verbatim).
+/// Pinned inline leaf: materializes inside the pinned `decode_subframe`.
+#[inline(always)]
+#[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]
+fn parse_subframe_type(reader: &mut Reader<'_>) -> Result<SubframeType, Error> {
+    if reader.read_bits(1)? != 0 {
+        return Err(Error::InvalidField);
+    }
+    let code = reader.read_bits(6)? as u8;
+    match code {
+        0b000000 => Ok(SubframeType::Constant),
+        0b000001 => Ok(SubframeType::Verbatim),
+        0b001000..=0b001100 => Ok(SubframeType::Fixed(code - 8)),
+        0b100000..=0b111111 => Ok(SubframeType::Lpc { order: code - 31 }),
+        _ => Err(Error::InvalidField),
+    }
+}
+
+/// Vendored `subframe::PredictorState::fill` (reader type swapped; verbatim,
+/// i64 pad kept exactly as live). Pinned inline leaf.
+#[inline(always)]
+#[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]
+fn fill_state(
+    state: &mut PredictorState,
+    reader: &mut Reader<'_>,
+    order: usize,
+    subframe_bits: u8,
+    wasted: u32,
+) -> Result<(), Error> {
+    if order > MAX_LPC_ORDER {
+        return Err(Error::UnsupportedPredictorOrder);
+    }
+    if wasted >= 32 {
+        return Err(Error::InvalidField);
+    }
+    let mut warm = [0i32; MAX_LPC_ORDER];
+    for slot in (0..order).rev() {
+        let v = reader.read_signed(u32::from(subframe_bits))?;
+        warm[slot] = ((i64::from(v)) << wasted) as i32;
+    }
+    state.warm_up = warm;
+    state.len = order;
+    Ok(())
+}
+
+/// Vendored `subframe::pad_block` — i64-then-truncate exactly as live.
+/// Pinned inline leaf.
+#[inline(always)]
+#[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]
+fn pad_block(out: &mut [i32], wasted: u32) {
+    if wasted == 0 {
+        return;
+    }
+    for s in out.iter_mut() {
+        *s = ((i64::from(*s)) << wasted) as i32;
+    }
+}
+
+/// Vendored `subframe::integrate_fixed` — i64 cascade verbatim. Pinned.
+#[inline(never)]
+#[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]
+fn integrate_fixed(order: u8, warm_up: &PredictorState, residual: &mut [i32]) -> Result<(), Error> {
+    let order = usize::from(order);
+    if order > MAX_FIXED_ORDER {
+        return Err(Error::UnsupportedPredictorOrder);
+    }
+    if warm_up.len < order {
+        return Err(Error::InvalidField);
+    }
+    let w = &warm_up.warm_up;
+    let mut d1;
+    let mut d2 = 0i64;
+    let mut d3 = 0i64;
+    let mut out = 0i64;
+    match order {
+        0 => return Ok(()),
+        1 => {
+            d1 = i64::from(w[0]);
+        }
+        2 => {
+            d1 = i64::from(w[0]) - i64::from(w[1]);
+            out = i64::from(w[0]);
+        }
+        3 => {
+            d2 = i64::from(w[0]) - 2 * i64::from(w[1]) + i64::from(w[2]);
+            d1 = i64::from(w[0]) - i64::from(w[1]);
+            out = i64::from(w[0]);
+        }
+        _ => {
+            d3 = i64::from(w[0]) - 3 * i64::from(w[1]) + 3 * i64::from(w[2]) - i64::from(w[3]);
+            d2 = i64::from(w[0]) - 2 * i64::from(w[1]) + i64::from(w[2]);
+            d1 = i64::from(w[0]) - i64::from(w[1]);
+            out = i64::from(w[0]);
+        }
+    }
+    for sample in residual.iter_mut() {
+        let r = i64::from(*sample);
+        match order {
+            1 => {
+                d1 += r;
+                out = d1;
+            }
+            2 => {
+                d1 += r;
+                out += d1;
+            }
+            3 => {
+                d2 += r;
+                d1 += d2;
+                out += d1;
+            }
+            _ => {
+                d3 += r;
+                d2 += d3;
+                d1 += d2;
+                out += d1;
+            }
+        }
+        *sample = out as i32;
+    }
+    Ok(())
+}
+
+/// Vendored `subframe::integrate_lpc` — i64 dot product verbatim. Pinned.
+#[inline(never)]
+#[cfg_attr(target_arch = "arm", unsafe(link_section = ".iwram"))]
+fn integrate_lpc(
+    coefficients: &[i32],
+    shift: i8,
+    warm_up: &PredictorState,
+    residual: &mut [i32],
+) -> Result<(), Error> {
+    if shift < 0 {
+        return Err(Error::InvalidField);
+    }
+    let order = coefficients.len();
+    if order > MAX_LPC_ORDER {
+        return Err(Error::UnsupportedPredictorOrder);
+    }
+    if warm_up.len < order {
+        return Err(Error::InvalidField);
+    }
+    let shift = u32::from(shift as u8);
+    if shift >= 64 {
+        return Err(Error::InvalidField);
+    }
+    let w = &warm_up.warm_up;
+    for i in 0..residual.len() {
+        let mut acc = 0i64;
+        for (j, &c) in coefficients.iter().enumerate() {
+            let past = if j < i {
+                i64::from(residual[i - 1 - j])
+            } else {
+                i64::from(w[j - i])
+            };
+            acc += i64::from(c) * past;
+        }
+        residual[i] = ((acc >> shift) + i64::from(residual[i])) as i32;
+    }
+    Ok(())
