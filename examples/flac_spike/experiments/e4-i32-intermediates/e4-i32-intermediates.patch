+                }
+            };
+            // The equality witness, OUTSIDE both windows: the variant arm
+            // must decode bit-identically to the proven-correct control.
+            let bad = {
+                let mut found = None;
+                for k in 0..written {
+                    if ctrl_l[k] != var_l[k] {
