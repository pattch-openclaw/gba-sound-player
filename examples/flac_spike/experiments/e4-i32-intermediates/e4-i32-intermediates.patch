+            if let Some((slot, k, cv, vv)) = bad {
+                agb::println!(
+                    "*** {} e4 FAIL frame {}: variant diverges from ctrl in {}[{}] ctrl={} variant={} — numbers void",
+                    name,
+                    frame_index,
+                    slot,
+                    k,
+                    cv,
+                    vv
+                );
+                return None;
+            }
+            let ctrl_net = ctrl_raw.saturating_sub(overhead);
+            let var_net = var_raw.saturating_sub(overhead);
+            ctrl_cost.observe(frame_index, ctrl_net);
+            var_cost.observe(frame_index, var_net);
+            agb::println!(
+                "*** {} e4 frame {:>3}/{} bs={} ctrl_raw={} ctrl_net={} var_raw={} var_net={} eq=1",
+                name,
+                frame_index,
+                clip.frames.len(),
+                written,
+                ctrl_raw,
+                ctrl_net,
+                var_raw,
+                var_net
+            );
+        }
+
+        let mut pass = ctrl_cost.count == clip.frames.len() && var_cost.count == clip.frames.len();
+        if !pass {
+            agb::println!(
+                "*** {} e4 FAIL timed frames ctrl={} variant={} expected={}",
+                name,
+                ctrl_cost.count,
+                var_cost.count,
+                clip.frames.len()
+            );
+        }
