+        }
+        for (arm, cost) in [("ctrl", &ctrl_cost), ("variant", &var_cost)] {
+            agb::println!(
+                "*** {} e4 {} stats: count={} min={}@{} max={}@{} sum={} wrapped={}",
+                name,
+                arm,
+                cost.count,
+                cost.min,
+                cost.min_frame,
+                cost.max,
+                cost.max_frame,
+                cost.sum,
+                cost.wrapped
+            );
+            agb::println!(
+                "*** {} e4 {} budget: worst_frame={} worst_net={} vs budget={} [{}]",
