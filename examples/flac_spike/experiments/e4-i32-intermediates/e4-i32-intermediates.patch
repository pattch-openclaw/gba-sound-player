+                "*** {} e4 FAIL IME={} inside window (expected 0) — windows were interruptable",
+                name,
+                ime_inside
+            );
+            return None;
+        }
+
+        agb::println!(
+            "*** {} e4 pass: walking {} frames (two IRQ-off windows + equality witness per frame)",
+            name,
+            clip.frames.len()
+        );
+        let mut ctrl_cost = FrameCost::new();
+        let mut var_cost = FrameCost::new();
+        for frame_index in 0..clip.frames.len() {
+            let (ctrl_res, ctrl_raw) = timed(counter, || {
+                driver::decode_one(clip, frame_index, &mut ctrl_l, &mut ctrl_r, &mut state_c)
+            });
+            let (var_res, var_raw) = timed(counter, || {
+                e4::decode_one_i32(clip, frame_index, &mut var_l, &mut var_r, &mut state_v)
+            });
