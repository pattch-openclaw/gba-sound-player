+        }
+        let ime_inside = probes[E4_CALIB_TOTAL - CALIBRATION_SAMPLES];
+        let overhead = raws[0];
+        let stable = raws.iter().all(|r| *r == overhead);
+        agb::println!(
+            "*** {} e4: ctrl = driver::decode_one (verbatim PR 3) | variant = e4::decode_one_i32",
+            name
+        );
+        agb::println!(
+            "*** {} e4 calibration: overhead_estimate={} stable={} ime_inside={} raws=[{} {} {} {} {}]",
+            name,
+            overhead,
+            stable,
+            ime_inside,
+            raws[0],
+            raws[1],
+            raws[2],
+            raws[3],
+            raws[4]
+        );
