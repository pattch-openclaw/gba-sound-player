+//! E4 sample — i32-intermediates decode path (**probe code; never lands
+//! on `main`'s spike sources**).
+//!
+//! FLAC.md "Perf follow-ups — experiment menu", E4: the decode path's hot
+//! arithmetic accumulates in `i64` intermediates on a 32-bit ARM7TDMI with
+//! no 64-bit registers — every i64 add is multi-instruction, and i64 shifts
+//! by a *variable* route through `__aeabi` helper calls. This module is a
+//! vendored variant of the `flac-lite` hot path (`frame::decode_frame` →
+//! `subframe::decode_subframe` → integrators → `stereo::decorrelate`) with
+//! the intermediate width switched to `i32`, measured against the verbatim
+//! control by `src/main.rs` on one image. `flac-lite` itself is untouched —
+//! the same sample-only discipline as `experiments/e1-rom-ram-staging/`.
+//!
+//! ## Why i32 is *provably* equivalent here (the E4 proof obligation)
+//!
+//! The i64 path's convention is already "truncate at the store" (`as i32`).
+//! Write Z for the integers and π for truncation mod 2^32:
+//!
+//! * **Ring sites — unconditional.** `+`, `−`, `×`, and `<<` commute with
+//!   π: π(x ⊕ y) = π(π(x) ⊕ π(y)) for ⊕ ∈ {+, −, ×, <<}. So for any input —
+//!   legal or corrupt — a wrapping-i32 computation, truncated at the store,
+//!   is bit-identical to the i64 computation truncated at the same store.
+//!   This covers: `integrate_fixed` (pure add cascade + add/sub seeds),
+//!   `pad_block` (`<< wasted` then store), the CONSTANT/VERBATIM/residual
+//!   writes (already i32), and the LeftSide/RightSide decorrelate arms
+//!   (single add/sub per sample).
+//! * **Arithmetic-shift sites — conditional on a range bound.** `>>` does
+//!   NOT commute with π (the high bits carry magnitude and sign). Two sites
+//!   right-shift an intermediate: the LPC dot product `(acc >> shift)` and
+//!   mid/side's `(m_ext ± side) >> 1`. Each is exact whenever the true
+//!   (i64-scale) value fits `i32`, and:
+//!   - LPC: `|acc| ≤ order × max|coeff| × max|past|`. Under the constrained
+//!     profile: order ≤ 4; 16-bit source ⇒ decoded (stripped-scale) samples
+//!     ≤ 2^16 (side slot, bps+1); measured profile max precision 11 bits ⇒
+//!     |coeff| < 2^10 (measured max on the spike clips: 751). Bound:
+//!     4 × 2^10 × 2^16 = 2^28 ≪ 2^31. Measured on the spike clips directly:
+//!     4 × 751 × 1115 ≈ 3.35e6 (sample max 1115, cross-arm).
+//!   - mid/side: `|m_ext| = |2m + (s & 1)| ≤ 2^17` and `|m_ext ± s| ≤ 3×2^16`
+//!     for legal 8/16-bit streams (|m|, |s| ≤ 2^16 at the coded scale) —
+//!     fits i32 with ≥ 2^13 margin; `>> 1` of a fitting value commutes.
+//! * `PredictorState::fill` keeps its `i64` pad: ≤ order (≤ 4) iterations
+//!   per subframe, per *frame* not per sample — outside the hot loop, so it
+//!   stays shared with the control (the variable is the hot-path width).
+//!
+//! Production would need a pack-time guard capping LPC precision (the
+//! 2^28 bound used profile precision ≤ 11; even the format-wide precision
+//! ≤ 15 only reaches 2^32, and precision ≤ 13 is safe at 2^30) — recorded
+//! in FLAC.md's E4 entry, not enforced here.
+//!
+//! ## Witness chain (before any number counts)
+//!
+//! 1. Host (`tests/e4_witness.rs`): this vendored path decodes the exact
+//!    embedded clips bit-exactly vs the `flac -d` reference PCM — the same
+//!    layer-2 witness `spike_witness.rs` runs for the production path.
+//! 2. ROM: a per-frame variant-vs-control sample-equality pass (the E1
+//!    pattern) proves both paths agree on the measured image itself; first
+//!    offender named; divergence voids the numbers.
+
+use crate::assets::SpikeClip;
+use crate::driver::DriverError;
+use flac_lite::bits::BitReader;
+use flac_lite::format::ChannelConfig;
+use flac_lite::frame::{FrameHeader, StreamDefaults};
+use flac_lite::residual::decode_residual;
+use flac_lite::subframe::{PredictorState, SubframeType};
+
+/// Decode exactly one frame with the i32-intermediates path — the variant
+/// twin of `driver::decode_one` (same seek-table offset walk, same table
+/// cross-check, same fresh cursor; the only difference is which
+/// `decode_frame` runs beneath).
+pub fn decode_one_i32(
+    clip: &SpikeClip,
+    frame_index: usize,
+    left: &mut [i32],
+    right: &mut [i32],
+    state: &mut [PredictorState; 2],
+) -> Result<usize, DriverError> {
+    let frame = &clip.frames[frame_index];
+    let max = usize::from(clip.max_blocksize);
+    if left.len() < max {
+        return Err(DriverError::BufferTooSmall {
+            need: max,
+            have: left.len(),
+        });
+    }
+    if clip.channels == 2 && right.len() < max {
+        return Err(DriverError::BufferTooSmall {
+            need: max,
+            have: right.len(),
+        });
+    }
+    let offset = match usize::try_from(frame.offset) {
+        Ok(offset) => offset,
+        Err(_) => {
+            return Err(DriverError::FrameOffsetOutOfRange {
+                frame: frame_index,
+                offset: usize::MAX,
+                len: clip.region.len(),
+            });
+        }
+    };
+    let region = clip
+        .region
+        .get(offset..)
+        .ok_or(DriverError::FrameOffsetOutOfRange {
+            frame: frame_index,
+            offset,
+            len: clip.region.len(),
+        })?;
+
+    let defaults = StreamDefaults {
+        sample_rate_hz: clip.sample_rate_hz,
+        bits_per_sample: clip.bits_per_sample,
+    };
+    let mut reader = BitReader::new(region);
+    let header = FrameHeader::parse(&mut reader, &defaults).map_err(DriverError::Decode)?;
+    if header.blocksize != usize::from(frame.blocksize) {
+        return Err(DriverError::MetadataMismatch {
+            frame: frame_index,
+            table: usize::from(frame.blocksize),
+            header: header.blocksize,
+        });
+    }
+    decode_frame_i32(&mut reader, &header, left, right, state).map_err(DriverError::Decode)
+}
+
+/// Vendored variant of `flac_lite::frame::decode_frame` (field parse,
+/// subframe dispatch, decorrelation, footer consumption all identical
+/// control flow; only the arithmetic width differs below).
+fn decode_frame_i32(
+    reader: &mut BitReader<'_>,
+    header: &FrameHeader,
+    left: &mut [i32],
+    right: &mut [i32],
+    state: &mut [PredictorState; 2],
+) -> Result<usize, flac_lite::Error> {
+    let blocksize = header.blocksize;
+    let slots = usize::from(header.channels.subframe_count());
+
+    if left.len() < blocksize || (slots == 2 && right.len() < blocksize) {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let side_slot = match header.channels {
+        ChannelConfig::RightSide => Some(0),
+        ChannelConfig::LeftSide | ChannelConfig::MidSide => Some(1),
+        ChannelConfig::Independent { .. } => None,
+    };
+    let slot_bits = |slot: usize| -> u8 {
+        (u32::from(header.bits_per_sample) + u32::from(side_slot == Some(slot))) as u8
+    };
+
+    decode_subframe_i32(
+        reader,
+        blocksize,
+        slot_bits(0),
+        &mut state[0],
+        &mut left[..blocksize],
+    )?;
+    if slots == 2 {
+        decode_subframe_i32(
+            reader,
+            blocksize,
+            slot_bits(1),
+            &mut state[1],
+            &mut right[..blocksize],
+        )?;
+    }
+    let right_span = if slots == 2 { blocksize } else { 0 };
+    decorrelate_i32(
+        header.channels,
+        blocksize,
+        &mut left[..blocksize],
+        &mut right[..right_span],
+    )?;
+
+    reader.byte_align();
+    let _crc16_hi = reader.read_u8()?;
+    let _crc16_lo = reader.read_u8()?;
+    Ok(blocksize)
+}
+
+/// Vendored variant of `subframe::decode_subframe`: shared field readers
+/// (`SubframeType::parse`, `read_wasted_bits`, `PredictorState::fill`,
+/// `decode_residual`) + i32 integrators and `pad_block`.
+fn decode_subframe_i32(
+    reader: &mut BitReader<'_>,
+    blocksize: usize,
+    sample_bits: u8,
+    state: &mut PredictorState,
+    out: &mut [i32],
+) -> Result<SubframeType, flac_lite::Error> {
+    if out.len() != blocksize {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let kind = SubframeType::parse(reader)?;
+    let order = kind.order();
+    if order > blocksize {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let wasted = reader.read_wasted_bits()?;
+    let sub_bits = u32::from(sample_bits)
+        .checked_sub(wasted)
+        .filter(|&b| b > 0 && b <= 32)
+        .ok_or(flac_lite::Error::InvalidField)?;
+    let subframe_bits = sub_bits as u8;
+    state.fill(reader, order, subframe_bits, 0)?;
+    for (i, slot) in state.warm_up[..order].iter().rev().enumerate() {
+        out[i] = *slot;
+    }
+    match kind {
+        SubframeType::Constant => {
+            let v = reader.read_signed(sub_bits)?;
+            out.fill(v);
+        }
+        SubframeType::Verbatim => {
+            for sample in out.iter_mut() {
+                *sample = reader.read_signed(sub_bits)?;
+            }
+        }
+        SubframeType::Fixed(order_u8) => {
+            decode_residual(reader, blocksize, order, &mut out[order..])?;
+            integrate_fixed_i32(order_u8, state, &mut out[order..])?;
+        }
+        SubframeType::Lpc { order: _order_u8 } => {
+            let precision_minus_one = reader.read_bits(4)?;
+            if precision_minus_one == 0b1111 {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            let precision = precision_minus_one + 1;
+            let shift = reader.read_signed(5)?;
+            if shift < 0 {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            let mut coeffs = [0i32; flac_lite::MAX_LPC_ORDER];
+            for c in coeffs.iter_mut().take(order) {
+                *c = reader.read_signed(precision)?;
+            }
+            decode_residual(reader, blocksize, order, &mut out[order..])?;
+            integrate_lpc_i32(&coeffs[..order], shift as i8, state, &mut out[order..])?;
+        }
+    }
+    pad_block_i32(out, wasted);
+    Ok(kind)
+}
+
+/// §9.2.2's decoder multiply in i32 (`wrapping_shl`): pure ×2^w, ring site,
+/// unconditionally bit-identical to the i64-then-truncate control.
+fn pad_block_i32(out: &mut [i32], wasted: u32) {
+    if wasted == 0 {
+        return;
+    }
+    for s in out.iter_mut() {
+        *s = s.wrapping_shl(wasted);
+    }
+}
+
+/// FIXED integration with i32 accumulators. Pure add cascade: every
+/// accumulator update is `+` (ring site), and the control stores `out as
+/// i32` at exactly the point this variant stores `out` — so equivalence is
+/// unconditional (see module docs).
+fn integrate_fixed_i32(
+    order: u8,
+    warm_up: &PredictorState,
+    residual: &mut [i32],
+) -> Result<(), flac_lite::Error> {
+    let order = usize::from(order);
+    if order > flac_lite::MAX_FIXED_ORDER {
+        return Err(flac_lite::Error::UnsupportedPredictorOrder);
+    }
+    if warm_up.len < order {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let w = &warm_up.warm_up;
+    let mut d1;
+    let mut d2 = 0i32;
+    let mut d3 = 0i32;
+    let mut out = 0i32;
+    match order {
+        0 => return Ok(()),
+        1 => {
+            d1 = w[0];
+        }
+        2 => {
+            d1 = w[0].wrapping_sub(w[1]);
+            out = w[0];
+        }
+        3 => {
+            d2 = w[0].wrapping_sub(w[1].wrapping_mul(2)).wrapping_add(w[2]);
+            d1 = w[0].wrapping_sub(w[1]);
+            out = w[0];
+        }
+        _ => {
+            d3 = w[0]
+                .wrapping_sub(w[1].wrapping_mul(3))
+                .wrapping_add(w[2].wrapping_mul(3))
+                .wrapping_sub(w[3]);
+            d2 = w[0].wrapping_sub(w[1].wrapping_mul(2)).wrapping_add(w[2]);
+            d1 = w[0].wrapping_sub(w[1]);
+            out = w[0];
+        }
+    }
+    for sample in residual.iter_mut() {
+        let r = *sample;
+        match order {
+            1 => {
+                d1 = d1.wrapping_add(r);
+                out = d1;
+            }
+            2 => {
+                d1 = d1.wrapping_add(r);
+                out = out.wrapping_add(d1);
+            }
+            3 => {
+                d2 = d2.wrapping_add(r);
+                d1 = d1.wrapping_add(d2);
+                out = out.wrapping_add(d1);
+            }
+            _ => {
+                d3 = d3.wrapping_add(r);
+                d2 = d2.wrapping_add(d3);
+                d1 = d1.wrapping_add(d2);
+                out = out.wrapping_add(d1);
+            }
+        }
+        *sample = out;
+    }
+    Ok(())
+}
+
+/// LPC dot product in i32 with `wrapping_mul`/`wrapping_add` and the
+/// arithmetic `>>` on i32 (= single `asr`, no helper call). Exact whenever
+/// the true dot product fits i32 — proven for the profile and measured on
+/// the clips with ≥ 2^8 margin (module docs).
+fn integrate_lpc_i32(
+    coefficients: &[i32],
+    shift: i8,
+    warm_up: &PredictorState,
+    residual: &mut [i32],
+) -> Result<(), flac_lite::Error> {
+    if shift < 0 {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let order = coefficients.len();
+    if order > flac_lite::MAX_LPC_ORDER {
+        return Err(flac_lite::Error::UnsupportedPredictorOrder);
+    }
+    if warm_up.len < order {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let shift = u32::from(shift as u8);
+    if shift >= 32 {
+        // The s(5) field caps at 15; keep the shift in i32's defined range
+        // like the control does for i64 (>= 64).
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let w = &warm_up.warm_up;
+    for i in 0..residual.len() {
+        let mut acc = 0i32;
+        for (j, &c) in coefficients.iter().enumerate() {
+            let past = if j < i { residual[i - 1 - j] } else { w[j - i] };
+            acc = acc.wrapping_add(c.wrapping_mul(past));
+        }
+        residual[i] = (acc >> shift).wrapping_add(residual[i]);
+    }
+    Ok(())
+}
+
+/// Stereo decorrelation with i32 arithmetic (module docs: side arms are
+/// ring sites; mid/side's shifts fit i32 for any legal 8/16-bit stream).
+fn decorrelate_i32(
+    config: ChannelConfig,
+    blocksize: usize,
+    left: &mut [i32],
+    right: &mut [i32],
+) -> Result<(), flac_lite::Error> {
+    match config {
+        ChannelConfig::Independent { channels: 1 } => {
+            if left.len() < blocksize {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            Ok(())
+        }
+        ChannelConfig::Independent { .. } => {
+            if left.len() < blocksize || right.len() < blocksize {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            Ok(())
+        }
+        ChannelConfig::LeftSide => {
+            if left.len() < blocksize || right.len() < blocksize {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            for (l, s) in left[..blocksize].iter_mut().zip(&mut right[..blocksize]) {
+                let (l0, s0) = (*l, *s);
+                *l = l0;
+                *s = l0.wrapping_sub(s0);
+            }
+            Ok(())
+        }
+        ChannelConfig::RightSide => {
+            if left.len() < blocksize || right.len() < blocksize {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            for (s, r) in left[..blocksize].iter_mut().zip(&mut right[..blocksize]) {
+                let (s0, r0) = (*s, *r);
+                *s = s0.wrapping_add(r0);
+                *r = r0;
+            }
+            Ok(())
+        }
+        ChannelConfig::MidSide => {
+            if left.len() < blocksize || right.len() < blocksize {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            for (m, s) in left[..blocksize].iter_mut().zip(&mut right[..blocksize]) {
+                let (m0, s0) = (*m, *s);
+                let m_ext = m0.wrapping_shl(1) | (s0 & 1);
+                *m = m_ext.wrapping_add(s0) >> 1;
+                *s = m_ext.wrapping_sub(s0) >> 1;
+            }
+            Ok(())
+        }
+    }
+}
