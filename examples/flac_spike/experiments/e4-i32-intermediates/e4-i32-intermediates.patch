+    /// E4 probe pass (sample code): per frame, the verbatim PR 3 control
+    /// decode (`driver::decode_one`) and the i32-intermediates variant
+    /// (`e4::decode_one_i32`), each in its own IRQ-off window, on one image.
+    /// Same three-window discipline as the E1 sample: control and variant
+    /// measured side by side (never against a recalled log), plus a
+    /// per-frame variant-vs-control sample-equality witness OUTSIDE the
+    /// windows — the variant's numbers only count on a frame whose decoded
+    /// samples are bit-identical to the proven-correct control's.
+    ///
+    /// Calibration carries E1's fix: 3 discarded warm-up windows precede
+    /// the 5 reported samples (micro-windows are code-layout sensitive;
+    /// the pass's first window can measure deterministically cold).
+    ///
+    /// Returns `Some((ctrl_cost, variant_cost, overhead, ctrl_fits,
+    /// variant_fits))` whenever the harness completed; `None` = numbers
+    /// void (unstable calibration, IME on in-window, a driver rejection,
+    /// or a variant-vs-control divergence — each named on serial).
+    fn e4_timing_pass(
+        clip: &SpikeClip,
+        counter: &mut Counter<'_>,
+    ) -> Option<(FrameCost, FrameCost, u32, bool, bool)> {
+        let name = clip.name;
+        let max = usize::from(clip.max_blocksize);
+        let mut ctrl_l: alloc::vec::Vec<i32> = alloc::vec![0; max];
+        let mut ctrl_r: alloc::vec::Vec<i32> = alloc::vec![0; max];
+        let mut var_l: alloc::vec::Vec<i32> = alloc::vec![0; max];
+        let mut var_r: alloc::vec::Vec<i32> = alloc::vec![0; max];
+        let mut state_c = [PredictorState::new(), PredictorState::new()];
+        let mut state_v = [PredictorState::new(), PredictorState::new()];
+
+        // Calibration: same unified loop as the (patched) PR 3 pass — 3
+        // discarded + 5 reported windows in ONE byte-identical loop, no
+        // logging between windows. On this image, separate warm-up windows
+        // were not enough: the first *reported* window still read 2 cycles
+        // off the rest (raws 22/20/20/20/20) — whatever immediately
