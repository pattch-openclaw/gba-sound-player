+//! E8 host witness: the vendored, instrumented decode path reproduces the
+//! reference PCM **bit-exactly** on the exact embedded bytes.
+//!
+//! Correctness-before-speed (FLAC.md): no E8 attribution number counts from
+//! an image whose instrumented decode is not proven. This suite proves the
+//! *what* for the vendored copy (`flac_spike::e8`, NullMeter — timing
+//! inert on host); the ROM carries the per-frame variant-vs-control
+//! sample-equality witness proving the measured image decoded identically.
+//!
+//! Layers:
+//! 1. **Bit-exact decode** — vendored per-frame walk, whole clip,
+//!    interleaved i16-LE equal to the `flac -d` reference blob.
+//! 2. **Twin agreement** — vendored output equals the live driver's output
+//!    frame-for-frame (a shared misreading of the assets would still be
+//!    caught by layer 1's external witness).
+//! 3. **Bookkeeping** — gross/window bucket counts fold one observation
+//!    per window occurrence; residual-sample tally equals the decoded
+//!    samples minus the non-Rice subframe bodies (sanity: > 0, ≤ total);
+//!    `NullMeter`'s zero raws leave closure exactly balanced.
+
+use flac_lite::subframe::PredictorState;
+use flac_spike::assets::{CLIPS, L0_FIXED, L4_LPC};
+use flac_spike::driver;
+use flac_spike::e8::{self, BucketStats, NullMeter};
+
+const L0_PCM: &[u8] = include_bytes!("../assets/spike_l0_pcm.bin");
+const L4_PCM: &[u8] = include_bytes!("../assets/spike_l4_pcm.bin");
+
+/// Expected byte length of a clip's reference PCM (interleaved stereo
+/// i16) — same helper shape as `spike_witness.rs` (test-local by
+/// convention; the two suites stay independent).
+trait PcmLen {
+    fn pcm_expected_len(&self) -> usize;
+}
+
+impl PcmLen for flac_spike::assets::SpikeClip {
+    fn pcm_expected_len(&self) -> usize {
+        usize::try_from(self.total_samples).unwrap() * usize::from(self.channels) * 2
+    }
+}
+
+fn pcm_for(name: &str) -> &'static [u8] {
+    if name == L0_FIXED.name {
+        L0_PCM
+    } else if name == L4_LPC.name {
+        L4_PCM
+    } else {
+        panic!("witness suite does not know a blob for arm {name:?}")
+    }
+}
+
+/// Walk a clip through the vendored instrumented decode (NullMeter:
+/// every window raw is 0; only decode correctness + fold bookkeeping are
+/// exercised on host).
+fn decode_clip_e8(clip: &flac_spike::assets::SpikeClip) -> (Vec<u8>, BucketStats) {
+    let max = usize::from(clip.max_blocksize);
+    let mut left = vec![0i32; max];
+    let mut right = vec![0i32; max];
+    let mut state = [PredictorState::new(), PredictorState::new()];
+    let mut st = BucketStats::new();
+    let mut meter = NullMeter;
+    let mut got: Vec<u8> = Vec::with_capacity(clip.pcm_expected_len());
+    for frame in 0..clip.frames.len() {
+        let (result, _acc) = e8::decode_one_e8(
+            clip, frame, &mut left, &mut right, &mut state, &mut meter, &mut st, 0, 0, 0,
+        );
+        let written = result
+            .unwrap_or_else(|e| panic!("{}: e8 walk failed at frame {frame}: {e:?}", clip.name));
+        for i in 0..written {
+            let l = i16::try_from(left[i]).expect("decoded left fits i16 (16-bit profile)");
+            got.extend_from_slice(&l.to_le_bytes());
+            if clip.channels == 2 {
+                let r = i16::try_from(right[i]).expect("decoded right fits i16");
+                got.extend_from_slice(&r.to_le_bytes());
+            }
+        }
+    }
+    (got, st)
+}
+
+#[test]
+fn vendored_decode_is_bit_exact_against_the_reference_pcm() {
+    for clip in CLIPS {
+        let (got, _st) = decode_clip_e8(clip);
+        assert_eq!(
+            got,
+            pcm_for(clip.name),
+            "{}: vendored e8 decode diverged from the flac -d reference",
+            clip.name
+        );
+    }
+}
+
+#[test]
+fn vendored_decode_matches_the_live_driver() {
+    for clip in CLIPS {
+        let (got_e8, _st) = decode_clip_e8(clip);
+        let max = usize::from(clip.max_blocksize);
+        let mut left = vec![0i32; max];
+        let mut right = vec![0i32; max];
+        let mut state = Default::default();
+        let mut got_live: Vec<u8> = Vec::with_capacity(clip.pcm_expected_len());
+        driver::decode_clip(clip, &mut left, &mut right, &mut state, |_f, l, r| {
+            for (a, b) in l.iter().zip(r.iter()) {
+                let (a, b) = (
+                    i16::try_from(*a).expect("decoded left fits i16 (16-bit profile)"),
+                    i16::try_from(*b).expect("decoded right fits i16 (16-bit profile)"),
+                );
+                got_live.extend_from_slice(&a.to_le_bytes());
+                got_live.extend_from_slice(&b.to_le_bytes());
+            }
+        })
+        .unwrap_or_else(|e| panic!("{}: live driver walk failed: {e:?}", clip.name));
+        assert_eq!(
+            got_e8, got_live,
+            "{}: vendored e8 decode diverged from the live driver",
+            clip.name
+        );
+    }
+}
+
+#[test]
+fn fold_bookkeeping_counts_every_window() {
+    for clip in CLIPS {
+        let (_got, st) = decode_clip_e8(clip);
+        let frames = clip.frames.len();
+        // Gross: exactly one observation per frame.
+        assert_eq!(st.frames, frames);
+        assert_eq!(st.buckets[e8::W_GROSS].count, frames);
+        // Header: exactly one parse window per frame.
+        assert_eq!(st.buckets[e8::W_HDR].count, frames);
+        // Two subframes per frame (stereo clips) for prefix / pad.
+        assert_eq!(st.buckets[e8::W_PREFIX].count, 2 * frames);
+        assert_eq!(st.buckets[e8::W_PAD].count, 2 * frames);
+        // One decorrelate + one footer per frame.
+        assert_eq!(st.buckets[e8::W_DECORR].count, frames);
+        assert_eq!(st.buckets[e8::W_FOOTER].count, frames);
+        // Body dispatch: every subframe takes exactly one path —
+        // Fixed/Lpc through the integrator window, Constant/Verbatim
+        // through misc — so integ + misc == 2 per frame (the split between
+        // them is content-dependent; only the total is shape-determined).
+        assert_eq!(
+            st.buckets[e8::W_INTEG].count + st.buckets[e8::W_MISC].count,
+            2 * frames,
+            "{}: subframe body dispatch accounting",
+            clip.name
+        );
+        // Residual samples: positive, and never more than total samples.
+        let total = usize::try_from(clip.total_samples).unwrap();
+        assert!(
+            st.resid_samples > 0,
+            "{}: no residual samples seen",
+            clip.name
+        );
+        assert!(
+            st.resid_samples <= 2 * total as u64,
+            "{}: residual tally exceeds decoded samples",
+            clip.name
+        );
+        // Boundary buckets: observed once per frame that carried Rice
+        // samples (at most every frame).
+        assert!(st.buckets[e8::W_UNARY].count <= frames);
+        assert_eq!(
+            st.buckets[e8::W_UNARY].count,
+            st.buckets[e8::W_REST].count,
+            "{}: unary/rest buckets must observe the same frames",
+            clip.name
+        );
+        // NullMeter: zero raws balance the closure exactly, no tripwires.
+        assert_eq!(st.closure_sum, 0);
+        assert_eq!(st.closure_underflows, 0);
+        assert_eq!(st.big_deltas, 0);
+    }
+}
