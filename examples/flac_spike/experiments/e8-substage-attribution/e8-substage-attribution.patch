+//! E8 probe module — sub-stage attribution (FLAC.md experiment menu, E8).
+//!
+//! Measurement, not a variant: the decode math is a verbatim copy of the
+//! live `flac-lite` path (frame/subframe/residual composition, integrators,
+//! padding, unmap) built on the live shared primitives (reader, header
+//! parse, subframe-type parse, warm-up `fill`, `decorrelate`). The ONLY
+//! structural difference is instrumentation:
+//!
+//! - **Stage windows** (`Meter::timed`, the same IME-off window shape as
+//!   PR 3's harness) at the stage boundaries: header parse, subframe
+//!   prefix, residual header + per-partition parameter reads, escape
+//!   bodies, integrator, pad, decorrelate, footer, plus a misc bucket for
+//!   CONSTANT/VERBATIM bodies.
+//! - **Boundary reads** (`Meter::now`, raw 16-bit low half) at two points
+//!   per Rice *sample*: after the unary quotient loop, and at sample end —
+//!   splitting the per-sample hot loop into `unary` (E2b's addressable
+//!   share, per the E2a result: "the Rice unary loop as a shape") and
+//!   `rest` (remainder read + fold + guard + unmap + store).
+//!
+//! Why raw reads and not windows inside the hot loop: a `timed()` window
+//! costs ~22–24 cycles; two per sample would inflate the very loop under
+//! measurement by ~96 cycles/sample (≈9% of the FIXED arm's ~1,078
+//! c/sample — a material perturbation). A raw low-half read + wrapping
+//! delta costs one I/O read plus a few arithmetic cycles per boundary;
+//! the boundary op is calibrated in its own unified loop shape (a
+//! back-to-back read pair) and netted once per span. Determinism holds:
+//! IME is off for the whole gross window, and the 16-bit wrapping delta
+//! is exact for any per-sample span below 65,536 cycles —
+//! [`boundary_delta`] counts near-wrap deltas as a tripwire, and the
+//! per-frame closure check brackets every bucket under the gross window.
+//!
+//! Span attribution conventions (stated, not hidden): the per-sample loop
+//! bookkeeping (iterator advance, branch) falls inside the `unary` span;
+//! the store and loop-exit bookkeeping fall inside the `rest` span; each
+//! span ends with its own `now()` read, whose cost the boundary
+//! calibration nets (each span ends with exactly one read, each span is
+//! netted exactly once). The vendored copy also moves inlining layout
+//! along with the instrumentation (the menu's E6 confound) — the reading
+//! is the per-bucket *shares* of the same-image gross, stated with that
+//! caveat in the FLAC.md entry.
+//!
+//! Vendor boundary (the menu's rule): exactly the functions the
+//! instrumentation touches are re-implemented here — [`decode_one_e8`]
+//! (driver-seam copy), [`decode_frame_e8`], `decode_subframe_e8`,
+//! `decode_residual_e8`, and the Rice loop. Everything else is a live
+//! shared call or a verbatim copy of a private function
+//! ([`integrate_fixed_e8`], [`integrate_lpc_e8`], [`pad_block_e8`],
+//! [`rice_unmap_e8`], [`decode_escape_partition_e8`]).
+
+use crate::assets::SpikeClip;
+use crate::driver::DriverError;
+use crate::stats::FrameCost;
+use flac_lite::bits::BitReader;
+use flac_lite::format::ChannelConfig;
+use flac_lite::frame::{FrameHeader, StreamDefaults};
+use flac_lite::residual::PartitionHeader;
+use flac_lite::stereo::decorrelate;
+use flac_lite::subframe::{PredictorState, SubframeType};
+
+/// Timed-window bucket: `FrameHeader::parse`.
+pub const W_HDR: usize = 0;
+/// Timed-window bucket: subframe prefix — type parse + wasted bits + bps
+/// gate + warm-up `fill` + warm-up copy into `out`.
+pub const W_PREFIX: usize = 1;
+/// Timed-window bucket: residual header (method + partition order + MUST
+/// checks) and per-partition parameter/escape-width reads; LPC body
+/// fields (precision/shift/coefficients) ride here too.
+pub const W_RESID_HEAD: usize = 2;
+/// Timed-window bucket: escape-partition raw-sample loops.
+pub const W_ESCAPE: usize = 3;
+/// Timed-window bucket: FIXED/LPC integrators.
+pub const W_INTEG: usize = 4;
+/// Timed-window bucket: wasted-bit block padding.
+pub const W_PAD: usize = 5;
+/// Timed-window bucket: channel decorrelation (live shared call).
+pub const W_DECORR: usize = 6;
+/// Timed-window bucket: frame footer (byte-align + CRC-16 reads).
+pub const W_FOOTER: usize = 7;
+/// Timed-window bucket: bodies with no bucket of their own (CONSTANT /
+/// VERBATIM).
+pub const W_MISC: usize = 8;
+/// Boundary bucket: the unary quotient loop — exactly E2b's addressable
+/// share (plus per-sample loop bookkeeping; see module docs).
+pub const W_UNARY: usize = 9;
+/// Boundary bucket: remainder read + fold + guard + unmap + store.
+pub const W_REST: usize = 10;
+/// The per-frame gross window (one open/close around the whole
+/// instrumented frame decode).
+pub const W_GROSS: usize = 11;
+/// Number of buckets.
+pub const N_BUCKETS: usize = 12;
+
+/// Bucket names for the serial log (index == bucket id).
+pub const BUCKET_NAMES: [&str; N_BUCKETS] = [
+    "hdr",
+    "prefix",
+    "resid_head",
+    "escape",
+    "integ",
+    "pad",
+    "decorr",
+    "footer",
+    "misc",
+    "unary",
+    "rest",
+    "gross",
+];
+
+/// The measurement seam the vendored decode calls. Implemented on target
+/// by the ROM harness (timer pair + agb critical section); on host by
+/// [`NullMeter`] for the witness tests.
+pub trait Meter {
+    /// Raw read of the counter's low half (16-bit, wraps every 65,536
+    /// cycles). Called inside the gross window only, where IME is off.
+    fn now(&mut self) -> u16;
+
+    /// Run `work(args)` inside one IRQ-off measurement window (IME
+    /// save/disable/restore + composite counter read pair). The work
+    /// arrives as an argument (not a capture) so stage windows nest
+    /// inside the gross window's open/close without borrow conflicts. All
+    /// logging happens outside the window.
+    fn timed<A, T>(&mut self, args: A, work: impl FnOnce(A) -> T) -> (T, u32);
+
+    /// Open the gross window: save + disable IME, read the composite.
+    fn open(&mut self);
+
+    /// Close the gross window: read the composite, restore IME, return
+    /// the raw cycle delta.
+    fn close(&mut self) -> u32;
+}
+
+/// Host stub: zero-cost meter for the witness tests (raws are all 0 —
+/// only decode correctness and fold bookkeeping are witnessed on host,
+/// never timing).
+#[derive(Debug, Default)]
+pub struct NullMeter;
+
+impl Meter for NullMeter {
+    fn now(&mut self) -> u16 {
+        0
+    }
+    fn timed<A, T>(&mut self, args: A, work: impl FnOnce(A) -> T) -> (T, u32) {
+        (work(args), 0)
+    }
+    fn open(&mut self) {}
+    fn close(&mut self) -> u32 {
+        0
+    }
+}
+
+/// Near-wrap tripwire threshold for [`boundary_delta`] (60,000 of the
+/// 65,536 wrap period: the worst per-sample span in these clips is a few
+/// thousand cycles, so anything ≥ 60k means the span approached the wrap
+/// point and its delta may have wrapped).
+pub const BIG_DELTA_WARN: u32 = 60_000;
+
+/// Wrapping low-half delta between two boundary reads.
+///
+/// Exact for any true span < 65,536 cycles. A delta ≥ [`BIG_DELTA_WARN`]
+/// increments `big_deltas` — a tripwire count, not a rejection: the span
+/// itself is legal.
+#[must_use]
+pub fn boundary_delta(start: u16, end: u16, big_deltas: &mut u32) -> u32 {
+    let d = end.wrapping_sub(start) as u32;
+    if d >= BIG_DELTA_WARN {
+        *big_deltas += 1;
+    }
+    d
+}
+
+/// Per-sample accumulation for one frame's instrumented decode (the raw
+/// boundary spans and the raw window sum feeding the closure check).
+#[derive(Debug, Default)]
+pub struct FrameAcc {
+    /// Raw span cycles in the unary bucket this frame.
+    pub unary_raw: u32,
+    /// Raw span cycles in the rest bucket this frame.
+    pub rest_raw: u32,
+    /// Rice samples seen (Σ blocksize − order over Rice subframes).
+    pub samples: u32,
+    /// Raw cycles of every nested stage window this frame.
+    pub windows_raw: u64,
+    /// Raw cycles of this frame's gross window (echoed for the ROM's
+    /// per-frame closure log; the fold uses the same value).
+    pub gross_raw: u32,
+}
+
+/// Per-arm bucket folds for an instrumented pass.
+#[derive(Debug)]
+pub struct BucketStats {
+    /// One fold per bucket (index by the `W_*` constants). Window buckets
+    /// observe per window occurrence; `unary`/`rest` observe per frame
+    /// (that frame's netted span total); `gross` per frame.
+    pub buckets: [FrameCost; N_BUCKETS],
+    /// Frames folded.
+    pub frames: usize,
+    /// Cross-frame sum of gross − parts (raw; positive == unattributed
+    /// cost, negative == double-counting).
+    pub closure_sum: i64,
+    /// Smallest per-frame gross − parts across the pass.
+    pub closure_min: i64,
+    /// Largest per-frame gross − parts across the pass.
+    pub closure_max: i64,
+    /// Frames where the parts sum exceeded the gross window (impossible
+    /// unless a window double-counted).
+    pub closure_underflows: u32,
+    /// Rice samples through the boundary buckets (cross-frame).
+    pub resid_samples: u64,
+    /// Near-wrap boundary-delta tripwire count.
+    pub big_deltas: u32,
+    /// Nested stage windows opened (cross-frame, excludes gross).
+    pub windows: u64,
+}
+
+impl Default for BucketStats {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl BucketStats {
+    /// An empty fold set.
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            buckets: core::array::from_fn(|_| FrameCost::new()),
+            frames: 0,
+            closure_sum: 0,
+            closure_min: i64::MAX,
+            closure_max: i64::MIN,
+            closure_underflows: 0,
+            resid_samples: 0,
+            big_deltas: 0,
+            windows: 0,
+        }
+    }
+
+    /// Fold one nested stage window: net `raw − overhead` into `bucket`,
+    /// count the window, and add its raw to the frame accumulator.
+    pub fn observe_window(
+        &mut self,
+        acc: &mut FrameAcc,
+        bucket: usize,
+        frame: usize,
+        raw: u32,
+        overhead: u32,
+    ) {
+        self.buckets[bucket].observe(frame, raw.saturating_sub(overhead));
+        acc.windows_raw += u64::from(raw);
+        self.windows += 1;
+    }
+}
+
+fn sat_u32(v: u64) -> u32 {
+    u32::try_from(v).unwrap_or(u32::MAX)
+}
+
+/// Decode exactly one frame at its seek-table offset, attributing cycles
+/// into `st`. A copy of `driver::decode_one`'s contract checks verbatim
+/// (unbucketed — they land in the closure), then the instrumented frame
+/// inside one gross open/close.
+///
+/// `frame` is the fold's frame index (the seek-table index here).
+/// `w_overhead` / `b_overhead` / `g_overhead` are the arm's own
+/// calibration constants: subtracted per stage window / per boundary span
+/// / for the gross window respectively.
+pub fn decode_one_e8<M: Meter>(
+    clip: &SpikeClip,
+    frame: usize,
+    left: &mut [i32],
+    right: &mut [i32],
+    state: &mut [PredictorState; 2],
+    m: &mut M,
+    st: &mut BucketStats,
+    w_overhead: u32,
+    b_overhead: u32,
+    g_overhead: u32,
+) -> (Result<usize, DriverError>, FrameAcc) {
+    let mut acc = FrameAcc::default();
+    m.open();
+    let result = (|m: &mut M| -> Result<usize, DriverError> {
+        let meta = &clip.frames[frame];
+        let max = usize::from(clip.max_blocksize);
+        if left.len() < max {
+            return Err(DriverError::BufferTooSmall {
+                need: max,
+                have: left.len(),
+            });
+        }
+        if clip.channels == 2 && right.len() < max {
+            return Err(DriverError::BufferTooSmall {
+                need: max,
+                have: right.len(),
+            });
+        }
+        let offset = match usize::try_from(meta.offset) {
+            Ok(offset) => offset,
+            Err(_) => {
+                return Err(DriverError::FrameOffsetOutOfRange {
+                    frame,
+                    offset: usize::MAX,
+                    len: clip.region.len(),
+                });
+            }
+        };
+        let region = clip
+            .region
+            .get(offset..)
+            .ok_or(DriverError::FrameOffsetOutOfRange {
+                frame,
+                offset,
+                len: clip.region.len(),
+            })?;
+
+        let defaults = StreamDefaults {
+            sample_rate_hz: clip.sample_rate_hz,
+            bits_per_sample: clip.bits_per_sample,
+        };
+        let mut reader = BitReader::new(region);
+        let (hdr_res, hdr_raw) = m.timed((&mut reader, &defaults), |(reader, defaults)| {
+            FrameHeader::parse(reader, defaults)
+        });
+        st.observe_window(&mut acc, W_HDR, frame, hdr_raw, w_overhead);
+        let header = hdr_res.map_err(DriverError::Decode)?;
+        if header.blocksize != usize::from(meta.blocksize) {
+            return Err(DriverError::MetadataMismatch {
+                frame,
+                table: usize::from(meta.blocksize),
+                header: header.blocksize,
+            });
+        }
+        decode_frame_e8(
+            m,
+            &mut reader,
+            &header,
+            left,
+            right,
+            state,
+            st,
+            &mut acc,
+            frame,
+            w_overhead,
+        )
+        .map_err(DriverError::Decode)
+    })(m);
+    let gross_raw = m.close();
+    acc.gross_raw = gross_raw;
+
+    // Frame-exit folding: boundary buckets (netted per span), gross, and
+    // the closure fold. All outside any window.
+    st.frames += 1;
+    if acc.samples > 0 {
+        let n = u64::from(acc.samples);
+        st.resid_samples += n;
+        let un_net = u64::from(acc.unary_raw).saturating_sub(u64::from(b_overhead) * n);
+        let re_net = u64::from(acc.rest_raw).saturating_sub(u64::from(b_overhead) * n);
+        st.buckets[W_UNARY].observe(frame, sat_u32(un_net));
+        st.buckets[W_REST].observe(frame, sat_u32(re_net));
+    }
+    st.buckets[W_GROSS].observe(frame, gross_raw.saturating_sub(g_overhead));
+    let parts = acc.windows_raw + u64::from(acc.unary_raw) + u64::from(acc.rest_raw);
+    let closure = i64::from(gross_raw) - i64::try_from(parts).unwrap_or(i64::MAX);
+    st.closure_sum += closure;
+    st.closure_min = st.closure_min.min(closure);
+    st.closure_max = st.closure_max.max(closure);
+    if closure < 0 {
+        st.closure_underflows += 1;
+    }
+
+    (result, acc)
+}
+
+/// Copy of `flac_lite::frame::decode_frame` with stage windows. Body
+/// order, contracts, and error mapping verbatim from the live function;
+/// `decorrelate` stays a live shared call inside its own window.
+fn decode_frame_e8<M: Meter>(
+    m: &mut M,
+    reader: &mut BitReader<'_>,
+    header: &FrameHeader,
+    left: &mut [i32],
+    right: &mut [i32],
+    state: &mut [PredictorState; 2],
+    st: &mut BucketStats,
+    acc: &mut FrameAcc,
+    frame: usize,
+    w_overhead: u32,
+) -> Result<usize, flac_lite::Error> {
+    let blocksize = header.blocksize;
+    let slots = usize::from(header.channels.subframe_count());
+
+    // Caller contract before the first bit (live, verbatim). Unbucketed:
+    // these compares land in the closure.
+    if left.len() < blocksize || (slots == 2 && right.len() < blocksize) {
+        return Err(flac_lite::Error::InvalidField);
+    }
+
+    let side_slot = match header.channels {
+        ChannelConfig::RightSide => Some(0),
+        ChannelConfig::LeftSide | ChannelConfig::MidSide => Some(1),
+        ChannelConfig::Independent { .. } => None,
+    };
+    let slot_bits = |slot: usize| -> u8 {
+        (u32::from(header.bits_per_sample) + u32::from(side_slot == Some(slot))) as u8
+    };
+
+    decode_subframe_e8(
+        m,
+        reader,
+        blocksize,
+        slot_bits(0),
+        &mut state[0],
+        &mut left[..blocksize],
+        st,
+        acc,
+        frame,
+        w_overhead,
+    )?;
+    if slots == 2 {
+        decode_subframe_e8(
+            m,
+            reader,
+            blocksize,
+            slot_bits(1),
+            &mut state[1],
+            &mut right[..blocksize],
+            st,
+            acc,
+            frame,
+            w_overhead,
+        )?;
+    }
+
+    let right_span = if slots == 2 { blocksize } else { 0 };
+    let (dec_res, dec_raw) = m.timed(
+        (
+            header.channels,
+            blocksize,
+            &mut left[..blocksize],
+            &mut right[..right_span],
+        ),
+        |(channels, blocksize, left, right)| decorrelate(channels, blocksize, left, right),
+    );
+    st.observe_window(acc, W_DECORR, frame, dec_raw, w_overhead);
+    dec_res?;
+
+    let (foot_res, foot_raw) = m.timed(&mut *reader, |reader| -> Result<(), flac_lite::Error> {
+        reader.byte_align();
+        let crc16_hi = reader.read_u8()?;
+        let crc16_lo = reader.read_u8()?;
+        let _ = (crc16_hi, crc16_lo);
+        Ok(())
+    });
+    st.observe_window(acc, W_FOOTER, frame, foot_raw, w_overhead);
+    foot_res?;
+
+    Ok(blocksize)
+}
+
+/// Copy of `flac_lite::subframe::decode_subframe` with stage windows:
+/// prefix (type + wasted + bps gate + fill + warm-up copy), residual (its
+/// own buckets), integrator, pad. Body order verbatim from the live
+/// function.
+fn decode_subframe_e8<M: Meter>(
+    m: &mut M,
+    reader: &mut BitReader<'_>,
+    blocksize: usize,
+    sample_bits: u8,
+    state: &mut PredictorState,
+    out: &mut [i32],
+    st: &mut BucketStats,
+    acc: &mut FrameAcc,
+    frame: usize,
+    w_overhead: u32,
+) -> Result<SubframeType, flac_lite::Error> {
+    if out.len() != blocksize {
+        return Err(flac_lite::Error::InvalidField);
+    }
+
+    // --- prefix window: type parse, wasted bits, bps gate, fill, warm-up
+    // copy into out. Live order.
+    let (prefix_res, prefix_raw) = m.timed(
+        (&mut *reader, &mut *out, &mut *state),
+        |(reader, out, state)| -> Result<(SubframeType, usize, u8, u32), flac_lite::Error> {
+            let kind = SubframeType::parse(reader)?;
+            let order = kind.order();
+            if order > blocksize {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            let wasted = reader.read_wasted_bits()?;
+            let sub_bits = u32::from(sample_bits)
+                .checked_sub(wasted)
+                .filter(|&b| b > 0 && b <= 32)
+                .ok_or(flac_lite::Error::InvalidField)?;
+            let subframe_bits = sub_bits as u8;
+            // wasted = 0 on purpose (live): prediction runs at the
+            // stripped scale; pad_block applies §9.2.2's multiply at block
+            // exit.
+            state.fill(reader, order, subframe_bits, 0)?;
+            for (i, slot) in state.warm_up[..order].iter().rev().enumerate() {
+                out[i] = *slot;
+            }
+            Ok((kind, order, subframe_bits, wasted))
+        },
+    );
+    st.observe_window(acc, W_PREFIX, frame, prefix_raw, w_overhead);
+    let (kind, order, subframe_bits, wasted) = prefix_res?;
+
+    // --- body dispatch (live order).
+    match kind {
+        SubframeType::Constant => {
+            let (res, raw) = m.timed(
+                (&mut *reader, &mut *out),
+                |(reader, out)| -> Result<(), flac_lite::Error> {
+                    let v = reader.read_signed(u32::from(subframe_bits))?;
+                    out.fill(v);
+                    Ok(())
+                },
+            );
+            st.observe_window(acc, W_MISC, frame, raw, w_overhead);
+            res?;
+        }
+        SubframeType::Verbatim => {
+            let (res, raw) = m.timed(
+                (&mut *reader, &mut *out),
+                |(reader, out)| -> Result<(), flac_lite::Error> {
+                    for sample in out.iter_mut() {
+                        *sample = reader.read_signed(u32::from(subframe_bits))?;
+                    }
+                    Ok(())
+                },
+            );
+            st.observe_window(acc, W_MISC, frame, raw, w_overhead);
+            res?;
+        }
+        SubframeType::Fixed(order_u8) => {
+            decode_residual_e8(
+                m,
+                reader,
+                blocksize,
+                order,
+                &mut out[order..],
+                st,
+                acc,
+                frame,
+                w_overhead,
+            )?;
+            let (int_res, int_raw) = m.timed(
+                (order_u8, &mut *state, &mut out[order..]),
+                |(order, state, residual)| integrate_fixed_e8(order, state, residual),
+            );
+            st.observe_window(acc, W_INTEG, frame, int_raw, w_overhead);
+            int_res?;
+        }
+        SubframeType::Lpc { order: _order_u8 } => {
+            // §9.2.6 body fields — live order, bucketed with the residual
+            // head (both are fixed-shape per-subframe field reads).
+            let (head_res, head_raw) = m.timed(
+                &mut *reader,
+                |reader| -> Result<([i32; flac_lite::MAX_LPC_ORDER], i32), flac_lite::Error> {
+                    let precision_minus_one = reader.read_bits(4)?;
+                    if precision_minus_one == 0b1111 {
+                        return Err(flac_lite::Error::InvalidField);
+                    }
+                    let precision = precision_minus_one + 1;
+                    let shift = reader.read_signed(5)?;
+                    if shift < 0 {
+                        return Err(flac_lite::Error::InvalidField);
+                    }
+                    let mut coeffs = [0i32; flac_lite::MAX_LPC_ORDER];
+                    for c in coeffs.iter_mut().take(order) {
+                        *c = reader.read_signed(precision)?;
+                    }
+                    Ok((coeffs, shift))
+                },
+            );
+            st.observe_window(acc, W_RESID_HEAD, frame, head_raw, w_overhead);
+            let (coeffs, shift) = head_res?;
+
+            decode_residual_e8(
+                m,
+                reader,
+                blocksize,
+                order,
+                &mut out[order..],
+                st,
+                acc,
+                frame,
+                w_overhead,
+            )?;
+            let (int_res, int_raw) = m.timed(
+                (
+                    &coeffs[..order],
+                    shift as i8,
+                    &mut *state,
+                    &mut out[order..],
+                ),
+                |(coeffs, shift, state, residual)| integrate_lpc_e8(coeffs, shift, state, residual),
+            );
+            st.observe_window(acc, W_INTEG, frame, int_raw, w_overhead);
+            int_res?;
+        }
+    }
+    let (pad_res, pad_raw) = m.timed(&mut *out, |out| pad_block_e8(out, wasted));
+    st.observe_window(acc, W_PAD, frame, pad_raw, w_overhead);
+    pad_res?;
+    Ok(kind)
+}
+
+/// Copy of `flac_lite::residual::decode_residual` (live order and stream
+/// MUSTs verbatim). The residual header and every per-partition
+/// parameter/escape-width read fold into `W_RESID_HEAD`; escape bodies get
+/// a window (`W_ESCAPE`); Rice bodies run the boundary-read loop (no
+/// window — that is the point of the probe).
+fn decode_residual_e8<M: Meter>(
+    m: &mut M,
+    reader: &mut BitReader<'_>,
+    blocksize: usize,
+    predictor_order: usize,
+    out: &mut [i32],
+    st: &mut BucketStats,
+    acc: &mut FrameAcc,
+    frame: usize,
+    w_overhead: u32,
+) -> Result<(), flac_lite::Error> {
+    // Caller contract (live, verbatim; unbucketed → closure).
+    let Some(total) = blocksize.checked_sub(predictor_order) else {
+        return Err(flac_lite::Error::InvalidField);
+    };
+    if out.len() != total {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let (head_res, head_raw) = m.timed(
+        (&mut *reader, blocksize, predictor_order),
+        |(reader, blocksize, predictor_order)| -> Result<(u32, u32, usize, usize), flac_lite::Error> {
+            let (plen, escape) = match reader.read_bits(2)? {
+                0b00 => (4u32, 15u32),
+                0b01 => (5, 31),
+                _ => return Err(flac_lite::Error::InvalidField),
+            };
+            let partition_order = reader.read_bits(4)? as usize;
+            let partitions = 1usize << partition_order;
+            if blocksize & (partitions - 1) != 0 {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            let partition_samples = blocksize >> partition_order;
+            if predictor_order >= partition_samples {
+                return Err(flac_lite::Error::InvalidField);
+            }
+            Ok((plen, escape, partitions, partition_samples))
+        },
+    );
+    st.observe_window(acc, W_RESID_HEAD, frame, head_raw, w_overhead);
+    let (plen, escape, partitions, partition_samples) = head_res?;
+
+    let mut rest = out;
+    for partition in 0..partitions {
+        let count = if partition == 0 {
+            partition_samples - predictor_order
+        } else {
+            partition_samples
+        };
+        // Per-partition header reads (param + optional escape width).
+        let (param_res, param_raw) = m.timed(
+            (&mut *reader, plen, escape, count),
+            |(reader, plen, escape, count)| -> Result<PartitionHeader, flac_lite::Error> {
+                let param = reader.read_bits(plen)?;
+                Ok(if param == escape {
+                    let raw_bits = reader.read_bits(5)? as u8;
+                    PartitionHeader {
+                        order: 0,
+                        is_escape: true,
+                        raw_bits,
+                        sample_count: count as u16,
+                    }
+                } else {
+                    PartitionHeader {
+                        order: param as u8,
+                        is_escape: false,
+                        raw_bits: 0,
+                        sample_count: count as u16,
+                    }
+                })
+            },
+        );
+        st.observe_window(acc, W_RESID_HEAD, frame, param_raw, w_overhead);
+        let header = param_res?;
+
+        let (head_slice, tail) = rest.split_at_mut(count);
+        if header.is_escape {
+            let (res, raw) = m.timed(
+                (&mut *reader, header, head_slice),
+                |(reader, header, out)| decode_escape_partition_e8(reader, &header, out),
+            );
+            st.observe_window(acc, W_ESCAPE, frame, raw, w_overhead);
+            res?;
+        } else {
+            decode_rice_partition_e8(m, reader, &header, head_slice, st, acc)?;
+        }
+        rest = tail;
+    }
+    Ok(())
+}
+
+/// Copy of `residual.rs`'s private `decode_rice_partition` with the E8
+/// boundary split. Span structure per sample (module docs for the
+/// conventions): `now()` → unary loop → `now()` → remainder + fold +
+/// guard + unmap + store → `now()`, and that final read doubles as the
+/// next sample's unary-span start.
+fn decode_rice_partition_e8<M: Meter>(
+    m: &mut M,
+    reader: &mut BitReader<'_>,
+    header: &PartitionHeader,
+    out: &mut [i32],
+    st: &mut BucketStats,
+    acc: &mut FrameAcc,
+) -> Result<(), flac_lite::Error> {
+    if out.len() != usize::from(header.sample_count) {
+        // Caller contract violation (slice length must track the header).
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let order = u32::from(header.order);
+    let mut unary_acc: u32 = 0;
+    let mut rest_acc: u32 = 0;
+    let mut t = m.now();
+    for sample in out.iter_mut() {
+        // Unary quotient: count zeros until the terminating one (live).
+        let mut quotient: u32 = 0;
+        while reader.read_bits(1)? == 0 {
+            quotient += 1;
+        }
+        let t1 = m.now();
+        unary_acc += boundary_delta(t, t1, &mut st.big_deltas);
+        // Binary remainder — only when the parameter says so (live).
+        let remainder = if order == 0 {
+            0
+        } else {
+            reader.read_bits(order)?
+        };
+        // §9.2.7.3 value-limit guards (live, verbatim).
+        if order >= 32 || quotient > (u32::MAX >> order) {
+            return Err(flac_lite::Error::InvalidField);
+        }
+        let folded = (quotient << order) | remainder;
+        if folded == u32::MAX {
+            return Err(flac_lite::Error::InvalidField);
+        }
+        *sample = rice_unmap_e8(folded);
+        let t2 = m.now();
+        rest_acc += boundary_delta(t1, t2, &mut st.big_deltas);
+        t = t2;
+    }
+    acc.unary_raw = acc.unary_raw.saturating_add(unary_acc);
+    acc.rest_raw = acc.rest_raw.saturating_add(rest_acc);
+    acc.samples += out.len() as u32;
+    Ok(())
+}
+
+/// Verbatim copy of `residual.rs`'s private escape-partition loop.
+fn decode_escape_partition_e8(
+    reader: &mut BitReader<'_>,
+    header: &PartitionHeader,
+    out: &mut [i32],
+) -> Result<(), flac_lite::Error> {
+    if out.len() != usize::from(header.sample_count) {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    for sample in out.iter_mut() {
+        *sample = if header.raw_bits == 0 {
+            0
+        } else {
+            reader.read_signed(u32::from(header.raw_bits))?
+        };
+    }
+    Ok(())
+}
+
+/// Verbatim copy of `subframe.rs`'s private `pad_block`.
+fn pad_block_e8(out: &mut [i32], wasted: u32) -> Result<(), flac_lite::Error> {
+    if wasted == 0 {
+        return Ok(());
+    }
+    for s in out.iter_mut() {
+        *s = ((i64::from(*s)) << wasted) as i32;
+    }
+    Ok(())
+}
+
+/// Verbatim copy of `subframe.rs`'s private `integrate_fixed`.
+fn integrate_fixed_e8(
+    order: u8,
+    warm_up: &PredictorState,
+    residual: &mut [i32],
+) -> Result<(), flac_lite::Error> {
+    let order = usize::from(order);
+    if order > flac_lite::MAX_FIXED_ORDER {
+        return Err(flac_lite::Error::UnsupportedPredictorOrder);
+    }
+    if warm_up.len < order {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let w = &warm_up.warm_up;
+    let mut d1;
+    let mut d2 = 0i64;
+    let mut d3 = 0i64;
+    let mut out = 0i64;
+    match order {
+        0 => return Ok(()),
+        1 => {
+            d1 = i64::from(w[0]);
+        }
+        2 => {
+            d1 = i64::from(w[0]) - i64::from(w[1]);
+            out = i64::from(w[0]);
+        }
+        3 => {
+            d2 = i64::from(w[0]) - 2 * i64::from(w[1]) + i64::from(w[2]);
+            d1 = i64::from(w[0]) - i64::from(w[1]);
+            out = i64::from(w[0]);
+        }
+        _ => {
+            d3 = i64::from(w[0]) - 3 * i64::from(w[1]) + 3 * i64::from(w[2]) - i64::from(w[3]);
+            d2 = i64::from(w[0]) - 2 * i64::from(w[1]) + i64::from(w[2]);
+            d1 = i64::from(w[0]) - i64::from(w[1]);
+            out = i64::from(w[0]);
+        }
+    }
+    for sample in residual.iter_mut() {
+        let r = i64::from(*sample);
+        match order {
+            1 => {
+                d1 += r;
+                out = d1;
+            }
+            2 => {
+                d1 += r;
+                out += d1;
+            }
+            3 => {
+                d2 += r;
+                d1 += d2;
+                out += d1;
+            }
+            _ => {
+                d3 += r;
+                d2 += d3;
+                d1 += d2;
+                out += d1;
+            }
+        }
+        *sample = out as i32;
+    }
+    Ok(())
+}
+
+/// Verbatim copy of `subframe.rs`'s private `integrate_lpc`.
+fn integrate_lpc_e8(
+    coefficients: &[i32],
+    shift: i8,
+    warm_up: &PredictorState,
+    residual: &mut [i32],
+) -> Result<(), flac_lite::Error> {
+    if shift < 0 {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let order = coefficients.len();
+    if order > flac_lite::MAX_LPC_ORDER {
+        return Err(flac_lite::Error::UnsupportedPredictorOrder);
+    }
+    if warm_up.len < order {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let shift = u32::from(shift as u8);
+    if shift >= 64 {
+        return Err(flac_lite::Error::InvalidField);
+    }
+    let w = &warm_up.warm_up;
+    for i in 0..residual.len() {
+        let mut acc = 0i64;
+        for (j, &c) in coefficients.iter().enumerate() {
+            let past = if j < i {
+                i64::from(residual[i - 1 - j])
+            } else {
+                i64::from(w[j - i])
+            };
+            acc += i64::from(c) * past;
+        }
+        residual[i] = ((acc >> shift) + i64::from(residual[i])) as i32;
+    }
+    Ok(())
+}
+
+/// Verbatim copy of `residual.rs`'s private `rice_unmap`.
+fn rice_unmap_e8(n: u32) -> i32 {
+    if n & 1 == 0 {
+        (n >> 1) as i32
+    } else {
+        (!(n >> 1)) as i32
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn boundary_delta_exact_and_wrapping() {
+        let mut big = 0u32;
+        assert_eq!(boundary_delta(10, 42, &mut big), 32);
+        assert_eq!(boundary_delta(0xFFFF, 0x0004, &mut big), 5, "wraps exactly");
+        assert_eq!(boundary_delta(7, 7, &mut big), 0);
+        assert_eq!(big, 0, "no tripwires yet");
+    }
+
+    #[test]
+    fn boundary_delta_near_wrap_tripwire() {
+        let mut big = 0u32;
+        // 65,535 cycles is a legal-but-suspicious span; the delta is still
+        // reported, the counter is what fires.
+        assert_eq!(boundary_delta(1, 0, &mut big), 65_535);
+        assert_eq!(big, 1);
+        assert_eq!(
+            boundary_delta(0, BIG_DELTA_WARN as u16, &mut big),
+            BIG_DELTA_WARN
+        );
+        assert_eq!(big, 2, "threshold is inclusive");
+    }
+}
