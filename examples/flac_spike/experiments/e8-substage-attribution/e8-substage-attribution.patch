+                && (clip.channels != 2 || e8_r[..written] == ctrl_r[..written]);
+            if !eq {
+                agb::println!(
+                    "*** {} e8 FAIL equality at frame {} (first offender) — vendored decode diverged, numbers void",
+                    name,
+                    frame_index
+                );
+                pass = false;
+                break;
+            }
+
+            let parts = acc.windows_raw + u64::from(acc.unary_raw) + u64::from(acc.rest_raw);
+            let closure = i64::from(acc.gross_raw) - i64::try_from(parts).unwrap_or(i64::MAX);
+            agb::println!(
+                "*** {} e8 frame {:>3}/{} bs={} ctrl_net={} gross_raw={} parts={} closure={} unary_raw={} rest_raw={} samples={} windows={}",
+                name,
+                frame_index,
+                clip.frames.len(),
+                written,
+                ctrl_raw.saturating_sub(w_overhead),
+                acc.gross_raw,
+                parts,
+                closure,
+                acc.unary_raw,
+                acc.rest_raw,
+                acc.samples,
+                acc.windows_raw
+            );
+        }
+
+        pass &= ime_ok;
+        if !pass {
+            return None;
+        }
+        pass &= st.frames == clip.frames.len();
+        if !pass {
+            agb::println!(
+                "*** {} e8 FAIL folded frames={} expected={}",
+                name,
+                st.frames,
+                clip.frames.len()
+            );
+            return None;
+        }
+        if ctrl_cost.wrapped || st.buckets[e8::W_GROSS].wrapped {
+            agb::println!(
+                "*** {} e8 FAIL a gross/control window wrapped the composite",
+                name
+            );
+            return None;
+        }
+        if st.closure_underflows > 0 {
+            agb::println!(
+                "*** {} e8 FAIL closure underflows={} (parts exceeded gross — double-counted window)",
+                name,
+                st.closure_underflows
+            );
+            return None;
+        }
+
+        // --- the attribution table.
+        agb::println!(
+            "*** {} e8 ctrl stats: count={} min={}@{} max={}@{} sum={}",
+            name,
+            ctrl_cost.count,
+            ctrl_cost.min,
+            ctrl_cost.min_frame,
+            ctrl_cost.max,
+            ctrl_cost.max_frame,
+            ctrl_cost.sum
+        );
+        for (bucket, cost) in st.buckets.iter().enumerate() {
+            agb::println!(
+                "*** {} e8 bucket {:>10}: count={} min={}@{} max={}@{} sum={}",
+                name,
+                e8::BUCKET_NAMES[bucket],
+                cost.count,
+                cost.min,
+                cost.min_frame,
+                cost.max,
+                cost.max_frame,
+                cost.sum
+            );
+        }
+        agb::println!(
+            "*** {} e8 closure: sum={} min={} max={} underflows={} | resid_samples={} big_deltas={} windows={}",
+            name,
+            st.closure_sum,
+            st.closure_min,
+            st.closure_max,
+            st.closure_underflows,
+            st.resid_samples,
+            st.big_deltas,
+            st.windows
+        );
+        agb::println!(
+            "*** {} e8 summary: COMPLETED (calib w={} g={} b={})",
+            name,
+            w_overhead,
+            g_overhead,
+            b_overhead
+        );
+        Some((w_overhead, b_overhead, g_overhead))
+    }
