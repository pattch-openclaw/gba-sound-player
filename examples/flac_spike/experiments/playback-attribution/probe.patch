+    fn sample_clock(retries: &mut u32) -> u32 {
+        loop {
+            let t2a = unsafe { io_read_u16(REG_TM2_DATA) }; // SAFETY: fixed I/O address.
+            let s = unsafe { io_read_u16(REG_TM1_DATA) }.wrapping_sub(TM1_RELOAD); // SAFETY: fixed I/O address.
+            let t2b = unsafe { io_read_u16(REG_TM2_DATA) }; // SAFETY: fixed I/O address.
+            if t2a == t2b {
+                return u32::from(t2a) * (CHUNK as u32) + u32::from(s);
+            }
