+    /// (finished=true so a residue classifies as Tail, never Starved).
+    /// Runs strictly OUTSIDE every measured window — it replaces the IRQ
+    /// consumer's flow-control effect without an IRQ, a DMA, or a single
+    /// cycle inside t0..t3. Returns whole chunks taken.
+    fn drain_ring(drain_l: &mut [u8], drain_r: &mut [u8]) -> u32 {
+        let mut chunks = 0u32;
+        loop {
+            let remaining = critical_section::with(|cs| {
+                let mut feed = FEED.borrow_ref_mut(cs);
