+    impl Probe {
+        fn observe_frame(
+            &mut self,
+            idx: usize,
+            wait: u32,
+            decode: u32,
+            convert: u32,
+            cs: u32,
+            gross: u32,
+        ) {
+            self.wait.observe(wait, idx);
+            self.decode.observe(decode, idx);
+            self.convert.observe(convert, idx);
+            self.push_cs.observe(cs, idx);
+            self.gross.observe(gross, idx);
+            let parts = wait + decode + convert + cs;
+            match gross.checked_sub(parts) {
+                Some(gap) => self.closure_sum += gap,
+                None => self.closure_underflows += 1,
+            }
+            self.frames += 1;
+        }
+
+        /// Arm-equality fold (outside the measured windows): one XOR + one
+        /// MUL per decoded sample, planar L then R — the arms' outputs
+        /// cannot diverge silently while the stage numbers compare.
+        fn fold(&mut self, left: &[i32], right: &[i32]) {
+            for &s in left.iter().chain(right.iter()) {
+                self.hash ^= s as u32;
+                self.hash = self.hash.wrapping_mul(16_777_619);
+            }
+            self.samples += (left.len() + right.len()) as u64;
+        }
+    }
