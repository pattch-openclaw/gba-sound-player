+        // the reader's invariants. On status 1 the frame dies either way;
+        // the cursor is wherever the walk stopped (ratified item 1).
+        self.acc = rev32(st.w);
+        self.valid = st.v;
+        self.pos = st.ptr;
+        if st.status != 0 {
+            return Err(Error::EndOfStream);
+        }
+        Ok(())
+    }
