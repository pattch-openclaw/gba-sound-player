+/// Decode one frame (measurement shape: no census).
+pub fn decode_one_arm(
+    clip: &SpikeClip,
+    frame_index: usize,
+    left: &mut [i32],
+    right: &mut [i32],
+    state: &mut [PredictorState; 2],
+) -> Result<usize, DriverError> {
+    decode_one_impl(clip, frame_index, left, right, state, core::ptr::null_mut())
+}
