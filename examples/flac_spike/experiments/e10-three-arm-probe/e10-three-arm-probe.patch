+// Unit tests compile as part of the lib under the host test harness (same
+// gate as e2.rs's). Core-only, like the crate's other unit tests.
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use flac_lite::bits::BitReader;
+
+    /// Deterministic pseudo-random bytes (LCG, same shape as bits.rs's).
+    struct Lcg(u32);
+    impl Lcg {
+        fn next_u8(&mut self) -> u8 {
+            self.0 = self.0.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+            (self.0 >> 24) as u8
+        }
+    }
+
+    fn lcg_bytes(seed: u32, out: &mut [u8]) {
+        let mut rng = Lcg(seed);
+        for b in out.iter_mut() {
+            *b = rng.next_u8();
+        }
+    }
+
+    /// Naive leading-ones oracle, computed bit-by-bit.
+    fn naive_leading_ones(b: u8) -> u8 {
+        let mut count = 0u8;
+        for bit in (0..8).rev() {
+            if (b >> bit) & 1 == 1 {
+                count += 1;
+            } else {
+                break;
+            }
+        }
+        count
+    }
+
+    #[test]
+    fn leading_ones_table_is_exhaustively_correct() {
+        for (i, &got) in LEADING_ONES.iter().enumerate() {
+            assert_eq!(got, naive_leading_ones(i as u8), "entry {i:#04X}");
+        }
+        // The two boundary entries the count depends on.
+        assert_eq!(LEADING_ONES[0x00], 0);
+        assert_eq!(LEADING_ONES[0xFF], 8);
+    }
+
+    /// Write `bits` (MSB-first) of the low bits of `pattern` into `buf`
+    /// starting at bit `start`.
+    fn put_bits(buf: &mut [u8], start: usize, pattern: u32, width: u32) {
+        for j in 0..width {
+            let bit = (pattern >> (width - 1 - j)) & 1;
+            if bit == 1 {
+                let idx = start + j as usize;
+                buf[idx >> 3] |= 1 << (7 - (idx & 7));
+            }
+        }
+    }
+
+    #[test]
+    fn rice_quotient_sweeps_lengths_at_every_bit_offset() {
+        // Quotient lengths 0..=40 (crosses the byte-chunk path several
+        // ways) at every bit offset 0..7, against the naive per-bit loop
+        // on the same bytes. After the terminating one sits a recognizable
+        // remainder the reader must still hand out. Longest stream:
+        // 7 pad + 40 zeros + 1 terminator + 8 remainder = 56 bits.
+        for pad in 0u32..8 {
+            for q in 0u32..=40 {
+                let mut buf = [0u8; 16];
+                put_bits(&mut buf, 0, 0x5A >> (7 - pad.min(7)), pad); // filler
+                // q zeros then the terminating one: leave the zeros zero,
+                // set the one.
+                let one_idx = pad as usize + q as usize;
+                buf[one_idx >> 3] |= 1 << (7 - (one_idx & 7));
+                // Remainder: 0b10110011 after the terminating one.
+                put_bits(&mut buf, pad as usize + q as usize + 1, 0b1011_0011, 8);
+
+                let mut reader = AccumulatorReader::new(&buf);
+                if pad > 0 {
+                    let _ = reader.read_bits(pad).unwrap();
+                }
+                let got = reader.rice_quotient().unwrap();
+                assert_eq!(got, q, "pad {pad}, q {q}: table count");
+                // The remainder must ride the same window.
+                let rem = reader.read_bits(8).unwrap();
+                assert_eq!(rem, 0b1011_0011, "pad {pad}, q {q}: remainder");
+            }
+        }
+    }
+
+    #[test]
+    fn rice_quotient_matches_per_bit_loop_on_random_streams() {
+        // Differential against the live per-bit mechanism: on random
+        // streams (run lengths of every length, interleaved with other
+        // widths), the table count must return what the live loop counts,
+        // with the cursor identical.
+        for seed in [0xC0FF_EE00u32, 0x1234_5678, 0xDEAD_BEEF, 0x0BADC0DE] {
+            let mut data = [0u8; 64];
+            lcg_bytes(seed, &mut data);
+            // Ensure terminators: the sweep reads words at arbitrary
+            // positions, and an LCG stream can carry >40-bit zero runs.
+            // The per-bit oracle below rejects those identically, but pin
+            // termination anyway so EOF never masks a count bug.
+            let mut ctrl = BitReader::new(&data);
+            let mut var = AccumulatorReader::new(&data);
+            for round in 0..400usize {
+                if ctrl.bits_remaining() < 8 || var.bits_remaining() < 8 {
+                    break; // too short for a width read + a run probe
+                }
+                let flip = round % 5;
+                if flip == 0 {
+                    let n = (round % 7) as u32 + 1; // interleaved widths
+                    let c = ctrl.read_bits(n).unwrap();
+                    let v = var.read_bits(n).unwrap();
+                    assert_eq!(c, v, "seed {seed:#X} round {round}: width {n}");
+                }
+                // Per-bit oracle on the control side (live mechanism).
+                let mut oracle = 0u32;
+                loop {
+                    match ctrl.read_bits(1) {
+                        Ok(0) => oracle += 1,
+                        Ok(_) => break,
+                        Err(_) => break,
+                    }
+                }
+                let got = var.rice_quotient();
+                match got {
+                    Ok(q) => assert_eq!(q, oracle, "seed {seed:#X} round {round}: count"),
+                    Err(Error::EndOfStream) => {} // both reached EOF (frame dead)
+                    Err(e) => panic!("seed {seed:#X}: unexpected {e:?}"),
+                }
+                if ctrl.bits_remaining() == 0 || var.bits_remaining() == 0 {
+                    break;
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn rice_quotient_eof_restores_state() {
+        // Unterminated unary: zeros to end-of-slice.
+        let mut buf = [0u8; 4];
+        buf[0] = 0b1000_0000; // one consumed, then 31 zeros, no terminator
+        let mut reader = AccumulatorReader::new(&buf);
+        let _ = reader.read_bits(1).unwrap(); // the leading 1
+        let before = (reader.bit_position(), reader.bits_remaining());
+        assert_eq!(reader.rice_quotient(), Err(Error::EndOfStream));
+        assert_eq!(
+            (reader.bit_position(), reader.bits_remaining()),
+            before,
+            "EOF must restore the reader to the word start"
+        );
+        // Empty reader: immediate EOF.
+        let mut empty = AccumulatorReader::new(&[]);
+        assert_eq!(empty.rice_quotient(), Err(Error::EndOfStream));
+    }
+
+    #[test]
+    fn rice_quotient_tail_beyond_slice_end_reads_its_run() {
+        // A run that exactly fills the slice tail (no terminator) is EOF;
+        // one terminator in the final byte is a legal count.
+        let buf = [0x01u8]; // 0000_0001: quotient 7, terminates in-byte
+        let mut reader = AccumulatorReader::new(&buf);
+        assert_eq!(reader.rice_quotient(), Ok(7));
+        assert_eq!(reader.bit_position(), 8);
+
+        let buf = [0x00u8, 0x80u8]; // 0000_0000_1: quotient 8 crosses the byte
+        let mut reader = AccumulatorReader::new(&buf);
+        assert_eq!(reader.rice_quotient(), Ok(8));
+        assert_eq!(reader.bit_position(), 9);
+
+        let buf = [0x00u8, 0x00u8, 0x00u8]; // 24 zeros, no terminator: EOF
+        let mut reader = AccumulatorReader::new(&buf);
+        assert_eq!(reader.rice_quotient(), Err(Error::EndOfStream));
+        assert_eq!(reader.bit_position(), 0);
+    }
+
+    #[test]
+    fn reader_copy_matches_position_reader_on_mixed_width_sweeps() {
+        // The e2b reader must not have drifted from the E2a/live shape on
+        // the paths the count does not touch (the vendored e2 sweep, same
+        // widths incl. n=32/illegal, same cursor rules).
+        let widths: [u32; 18] = [
+            1, 1, 1, 2, 3, 5, 7, 8, 9, 12, 16, 20, 24, 25, 31, 32, 33, 11,
+        ];
+        for seed in [0x1234_5678u32, 0xDEAD_BEEF, 0x0F0F_F0F0, 0x88C7_7A3B] {
+            let mut data = [0u8; 40];
+            lcg_bytes(seed, &mut data);
+            let mut ctrl = BitReader::new(&data);
+            let mut var = AccumulatorReader::new(&data);
+            for round in 0..250usize {
+                let n = widths[(round * 7 + data[round % data.len()] as usize) % widths.len()];
+                let c = ctrl.read_bits(n);
+                let v = var.read_bits(n);
+                assert_eq!(c, v, "seed {seed:#X} round {round} width {n}: value");
+                assert_eq!(
+                    ctrl.bit_position(),
+                    var.bit_position(),
+                    "seed {seed:#X} round {round} width {n}: cursor"
+                );
+            }
+            // byte_align lands identically too.
+            let mut ctrl = BitReader::new(&data);
+            let mut var = AccumulatorReader::new(&data);
+            let _ = ctrl.read_bits(3);
+            let _ = var.read_bits(3);
+            assert_eq!(ctrl.byte_align(), var.byte_align());
+            assert_eq!(ctrl.bit_position(), var.bit_position());
+        }
+    }
+}
