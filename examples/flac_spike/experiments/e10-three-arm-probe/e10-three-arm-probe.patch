+}
+
+#[test]
+fn rice_table_variant_matches_production_driver_frame_by_frame() {
+    // Differential against the live per-bit mechanism on the exact
+    // embedded bytes: every frame's decoded samples must be identical,
+    // sample for sample, in both channels.
+    for clip in CLIPS {
+        let max = usize::from(clip.max_blocksize);
+        let mut ctrl_l = vec![0i32; max];
+        let mut ctrl_r = vec![0i32; max];
+        let mut var_l = vec![0i32; max];
