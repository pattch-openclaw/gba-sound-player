+        if let Some(ss) = self.stats_slot() {
+            ss.max_p = ss.max_p.max(u64::from(p));
+        }
+        let mut st = KernelState {
+            w: rev32(self.acc),
+            v: self.valid,
+            ptr: self.pos,
+            end: data.len(),
+            status: 0,
+        };
