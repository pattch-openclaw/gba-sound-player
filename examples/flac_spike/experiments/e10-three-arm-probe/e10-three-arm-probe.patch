+    let sample_rate = sample_rate(rate_code, reader)?;
+
+    let _crc8 = reader.read_u8()?;
+
+    Ok(FrameHeader {
+        blocksize,
+        sample_rate,
+        channels,
+        bits_per_sample,
+        number,
+    })
