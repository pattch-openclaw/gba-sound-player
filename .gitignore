/target
/gba-sound-player.gba
/flac-integration.gba
/flac-spike.gba
*.d

# mGBA writes a save file beside the ROM on every local run
# (e.g. `gba-sound-player.sav` next to `gba-sound-player.gba`).
# Emulator state, never build output we want tracked.
*.sav

# macOS Finder metadata
.DS_Store

# Standalone build dir for the symphonia FLAC compile probe example
# (examples/symphonia_flac_probe/ has its own Cargo.toml/workspace)
/examples/symphonia_flac_probe/target/

# flac-lite is its own workspace (crates/flac-lite/Cargo.toml has [workspace]),
# so it keeps its own target/ — and it builds for BOTH thumbv4t-none-eabi and the
# host triple, so the paths vary; ignore the whole dir. The root `/target` rule
# above is anchored and does not cover it.
/crates/*/target/

# Same story for the experimental FLAC integration ROM crate (examples/flac_integration/
# is its own workspace, builds only for thumbv4t-none-eabi via `make native-flac-rom`).
/examples/flac_integration/target/

# And the perf-gate spike crate (examples/flac_spike/ — own workspace; builds
# for the GBA target via `make native-spike-rom` AND for the host triple for
# its witness tests, so the paths vary; ignore the whole dir). NOTE: its
# assets/*.bin + src/assets.rs are deliberately TRACKED — they are committed
# generator output, the witness the spike measures.
/examples/flac_spike/target/

# Python bytecode caches (scripts/*.py); never commit.
__pycache__/
